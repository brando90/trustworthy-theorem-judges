/-! ### Equivalence -/

theorem forIn_inner_eq (n : Nat) (ns : List Nat) (ok : Bool) :
    (forIn (m := Id) ns ok fun v ok =>
        if n ≤ v then pure (ForInStep.yield false) else pure (ForInStep.yield ok)) =
      (ok && ns.all fun v => decide (v < n)) := by
  induction ns generalizing ok with
  | nil => simp
  | cons v ns ih =>
    rw [List.forIn_cons]
    by_cases h : n ≤ v
    · simp [h, ih]
    · simp [h, ih]

theorem forIn_outer_eq (n : Nat) (graph : List (List Nat)) (ok : Bool) :
    (forIn (m := Id) graph ok fun ns ok =>
        pure (ForInStep.yield (ok && ns.all fun v => decide (v < n)))) =
      (ok && graph.all fun ns => ns.all fun v => decide (v < n)) := by
  induction graph generalizing ok with
  | nil => simp
  | cons ns graph ih =>
    rw [List.forIn_cons]
    simp [ih, Bool.and_assoc]

theorem forIn_find_eq (p : List Nat → Bool) (l : List (List Nat)) (acc : Option (List Nat)) :
    (forIn (m := Id) l acc fun c found =>
        if (found.isNone && p c) = true then pure (ForInStep.yield (some c))
        else pure (ForInStep.yield found)) =
      (match acc with
        | some x => some x
        | none => l.find? p) := by
  induction l generalizing acc with
  | nil => cases acc <;> rfl
  | cons c l ih =>
    rw [List.forIn_cons]
    cases acc with
    | none =>
      by_cases hp : p c = true
      · simp only [Option.isNone_none, Bool.true_and, hp, if_true]
        show (forIn (m := Id) l (some c) _) = _
        rw [ih, List.find?_cons_of_pos hp]
      · simp only [Option.isNone_none, Bool.true_and, hp, if_false]
        show (forIn (m := Id) l none _) = _
        rw [ih, List.find?_cons_of_neg hp]
    | some x =>
      simp only [Option.isNone_some, Bool.false_and, if_false]
      show (forIn (m := Id) l (some x) _) = _
      rw [ih]

theorem topologicalSortImp_eq (graph : List (List Nat)) :
    topologicalSortImp graph = topologicalSort graph := by
  sorry

end topological_sort
