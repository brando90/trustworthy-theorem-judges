/-! ## Correctness -/

theorem correctness (graph : List (List Nat)) (_ : Pre graph) : Post_prop graph :=
  ⟨none_of_not_pre_thm graph, sound_thm graph, complete_thm graph, lexMin_thm graph,
    none_iff_thm graph, acyclic_thm graph, exists_of_acyclic_thm graph,
    none_iff_cycle_thm graph, covers_thm graph⟩

/-- The post-condition in fact holds for every input, well formed or not. -/
theorem post_unconditional (graph : List (List Nat)) : Post_prop graph :=
  ⟨none_of_not_pre_thm graph, sound_thm graph, complete_thm graph, lexMin_thm graph,
    none_iff_thm graph, acyclic_thm graph, exists_of_acyclic_thm graph,
    none_iff_cycle_thm graph, covers_thm graph⟩

/-! ## Imperative implementation -/

/-- Imperative version of `topological_sort`: a loop validating the adjacency lists, then a loop
over the permutations in lexicographic order that keeps the first accepted candidate. -/
def topologicalSortImp (graph : List (List Nat)) : Option (List Nat) := Id.run do
  let n := graph.length
  let mut ok := true
  for ns in graph do
    for v in ns do
      if n ≤ v then
        ok := false
  if !ok then
    return none
  let mut found : Option (List Nat) := none
  for candidate in lexPerms (List.range n) do
    if found.isNone && isTopologicalOrder graph candidate then
      found := some candidate
  return found

/-! ### Imperative tests -/

example : topologicalSortImp [[1], [2], []] = some [0, 1, 2] := by native_decide
