4: @[reducible]\n105: def zero_base_prop (base exponent : Nat) : Prop :=\n106:   (exponent > 0 → myPower 0 exponent = 0) ∧\n107:   (base = 0 → exponent > 0 → myPower base exponent = 0)\n108: \n109: theorem zero_base_thm (base exponent : Nat) : zero_base_prop base exponent := by\n110:   unfold zero_base_prop\n111:   refine ⟨?_, ?_⟩\n112:   · intro h\n113:     rw [myPower_eq_pow]\n114:     exact Nat.zero_pow h\n115:   · intro hb he\n116:     subst hb\n117:     rw [myPower_eq_pow]\n118:     exact Nat.zero_pow he\n119: \n120: /-- Edge case: `power(0, 0) = 1` by convention. -/\n121: @[reducible]\n122: def zero_zero_prop (base exponent : Nat) : Prop :=\n123:   myPower 0 0 = 1 ∧ (base = 0 → exponent = 0 → myPower base exponent = 1)\n124: \n125: theorem zero_zero_thm (base exponent : Nat) : zero_zero_prop base exponent := by\n126:   unfold zero_zero_prop\n127:   refine ⟨rfl, ?_⟩\n128:   intro hb he\n129:   subst hb; subst he\n130:   rfl\n131: \n132: /-- Base case: `power(n, 1) = n`. -/\n133: @[reducible]\n134: def exp_one_prop (base exponent : Nat) : Prop :=\n135:   myPower base 1 = base ∧ (exponent = 1 → myPower base exponent = base)\n136: \n137: theorem exp_one_thm (base exponent : Nat) : exp_one_prop base exponent := by\n138:   unfold exp_one_prop\n139:   refine ⟨by simp, ?_⟩\n140:   intro h\n141:   subst h\n142:   simp\n143: \n144: /-- Identity base: `power(1, n) = 1`. -/\n145: @[reducible]\n146: def one_base_prop (base exponent : Nat) : Prop :=\n147:   myPower 1 exponent = 1 ∧ (base = 1 → myPower base exponent = 1)\n148: \n149: theorem one_base_thm (base exponent : Nat) : one_base_prop base exponent := by\n150:   unfold one_base_prop\n151:   refine ⟨by simp, ?_⟩\n152:   intro h\n153:   subst h\n154:   simp\n155: \n156: /-- Recursive step property: `power(b, e + 1) = b * power(b, e) = power(b, e) * b`. -/\n157: @[reducible]\n158: def succ_exp_prop (base exponent : Nat) : Prop :=\n159:   myPower base (exponent + 1) = base * myPower base exponent ∧\n160:   myPower base (exponent + 1) = myPower base exponent * base\n161: \n162: theorem succ_exp_thm (base exponent : Nat) : succ_exp_prop base exponent := by\n163:   unfold succ_exp_prop\n164:   refine ⟨rfl, ?_⟩\n165:   simp [myPower, Nat.mul_comm]\n166: \n167: /-- Non-negativity: `power(base, exponent) ≥ 0`. -/\n168: @[reducible]\n169: def nonneg_prop (base exponent : Nat) : Prop :=\n170:   myPower base exponent ≥ 0\n171: \n172: theorem nonneg_thm (base exponent : Nat) : nonneg_prop base exponent := by\n173:   exact Nat.zero_le _\n174: \n175: /-- Positivity: `base > 0 → power(base, exponent) > 0`. -/\n176: @[reducible]\n177: def pos_prop (base exponent : Nat) : Prop :=\n178:   base > 0 → myPower base exponent > 0\n179: \n180: theorem pos_thm (base exponent : Nat) : pos_prop base exponent := by\n181:   unfold pos_prop\n182:   intro h\n183:   rw [myPower_eq_pow]\n184:   exact Nat.pow_pos h\n185: \n186: /-- Characterization of when `power(base, exponent) = 0`. -/\n187: @[reducible]\n188: def zero_iff_prop (base exponent : Nat) : Prop :=\n189:   myPower base exponent = 0 ↔ (base = 0 ∧ exponent > 0)\n190: \n191: theorem zero_iff_thm (base exponent : Nat) : zero_iff_prop base exponent := by\n192:   unfold zero_iff_prop\n193:   rw [myPower_eq_pow, Nat.pow_eq_zero]\n194:   omega\n195: \n196: /-- Characterization of when `power(base, exponent) = 1`. -/\n197: @[reducible]\n198: def one_iff_prop (base exponent : Nat) : Prop :=\n199:   myPower base exponent = 1 ↔ (base = 1 ∨ exponent = 0)\n200: \n201: theorem one_iff_thm (base exponent : Nat) : one_iff_prop base exponent := by\n202:   unfold one_iff_prop\n203:   rw [myPower_eq_pow, Nat.pow_eq_one]\n204: \n205: /-- Lower bound by base: `base > 0 → exponent > 0 → power(base, exponent) ≥ base`. -/\n206: @[reducible]\n207: def ge_base_prop (base exponent : Nat) : Prop :=\n208:   base > 0 → exponent > 0 → myPower base exponent ≥ base\n209: \n210: theorem ge_base_thm (base exponent : Nat) : ge_base_prop base exponent := by\n211:   unfold ge_base_prop\n212:   intro _hb he\n213:   rw [myPower_eq_pow]\n214:   exact Nat.le_self_pow (Nat.ne_of_gt he) base\n215: \n216: /-- Strict growth above 1: `base > 1 → exponent > 0 → power(base, exponent) > 1`. -/\n217: @[reducible]\n218: def gt_one_prop (base exponent : Nat) : Prop :=\n219:   base > 1 → exponent > 0 → myPower base exponent > 1\n220: \n221: theorem gt_one_thm (base exponent : Nat) : gt_one_prop base exponent := by\n222:   unfold gt_one_prop\n223:   intro hb he\n224:   rw [myPower_eq_pow]\n225:   exact Nat.one_lt_pow (Nat.ne_of_gt he) hb\n226: \n227: /-- Divisibility by base: `exponent > 0 → base ∣ power(base, exponent)`. -/\n228: @[reducible]\n229: def dvd_prop (base exponent : Nat) : Prop :=\n230:   exponent > 0 → base ∣ myPower base exponent\n231: \n232: theorem dvd_thm (base exponent : Nat) : dvd_prop base exponent := by\n233:   unfold dvd_prop\n234:   intro he\n235:   rw [myPower_eq_pow]\n236:   exact dvd_pow_self base (Nat.ne_of_gt he)\n237: \n238: /-- Product of powers law: `power(b, e1 + e2) = power(b, e1) * power(b, e2)`. -/\n239: @[reducible]\n240: def add_exp_prop (base e1 e2 : Nat) : Prop :=\n241:   myPower base (e1 + e2) = myPower base e1 * myPower base e2\n242: \n243: theorem add_exp_thm (base e1 e2 : Nat) : add_exp_prop base e1 e2 := by\n244:   unfold add_exp_prop\n245:   simp [Nat.pow_add]\n246: \n247: /-- Power of a product law: `power(b1 * b2, e) = power(b1, e) * power(b2, e)`. -/\n248: @[reducible]\n249: def mul_base_prop (b1 b2 exponent : Nat) : Prop :=\n250:   myPower (b1 * b2) exponent = myPower b1 exponent * myPower b2 exponent\n251: \n252: theorem mul_base_thm (b1 b2 exponent : Nat) : mul_base_prop b1 b2 exponent := by\n253:   unfold mul_base_prop\n254:   simp [Nat.mul_pow]\n255: \n256: /-- Power of a power law: `power(b, e1 * e2) = power(power(b, e1), e2)`. -/\n257: @[reducible]\n258: def mul_exp_prop (base e1 e2 : Nat) : Prop :=\n259:   myPower base (e1 * e2) = myPower (myPower base e1) e2\n260: \n261: theorem mul_exp_thm (base e1 e2 : Nat) : mul_exp_prop base e1 e2 := by\n262:   unfold mul_exp_prop\n263:   simp [Nat.pow_mul]\n264: \n265: /-- Monotonicity in the base: `b1 ≤ b2 → power(b1, e) ≤ power(b2, e)`. -/\n266: @[reducible]\n267: def mono_base_prop (b1 b2 exponent : Nat) : Prop :=\n268:   b1 ≤ b2 → myPower b1 exponent ≤ myPower b2 exponent\n269: \n270: theorem mono_base_thm (b1 b2 exponent : Nat) : mono_base_prop b1 b2 exponent := by\n271:   unfold mono_base_prop\n272:   intro h\n273:   simp [Nat.pow_le_pow_left h]\n274: \n275: /-- Monotonicity in the exponent: `base ≥ 1 → e1 ≤ e2 → power(base, e1) ≤ power(base, e2)`. -/\n276: @[reducible]\n277: def mono_exp_prop (base e1 e2 : Nat) : Prop :=\n278:   base ≥ 1 → e1 ≤ e2 → myPower base e1 ≤ myPower base e2\n279: \n280: theorem mono_exp_thm (base e1 e2 : Nat) : mono_exp_prop base e1 e2 := by\n281:   unfold mono_exp_prop\n282:   intro hb he\n283:   simp [Nat.pow_le_pow_right hb he]\n284: \n285: /-- Strict monotonicity in the exponent: `base > 1 → e1 < e2 → power(base, e1) < power(base, e2)`. -/\n286: @[reducible]\n287: def strict_mono_exp_prop (base e1 e2 : Nat) : Prop :=\n288:   base > 1 → e1 < e2 → myPower base e1 < myPower base e2\n289: \n290: theorem strict_mono_exp_thm (base e1 e2 : Nat) : strict_mono_exp_prop base e1 e2 := by\n291:   unfold strict_mono_exp_prop\n292:   intro hb he\n293:   simp [Nat.pow_lt_pow_right hb he]\n294: \n295: /-- Integer specification when precondition holds. -/\n296: @[reducible]\n297: def int_valid_prop (base exponent : Int) : Prop :=\n298:   PreInt base exponent →\n299:     myPowerInt base exponent = some (Int.ofNat (myPower base.toNat exponent.toNat)) ∧\n300:     myPowerInt base exponent = some (base ^ exponent.toNat)\n301: \n302: theorem int_valid_thm (base exponent : Int) : int_valid_prop base exponent := by\n303:   unfold int_valid_prop PreInt myPowerInt pre\n304:   intro ⟨hb, he⟩\n305:   have hcond : (decide (base ≥ 0) && decide (exponent ≥ 0)) = true := by\n306:     simp [hb, he]\n307:   rw [if_pos hcond]\n308:   refine ⟨rfl, ?_⟩\n309:   congr 1\n310:   rw [myPower_eq_pow]\n311:   have hb_eq : (base.toNat : Int) = base := Int.toNat_of_nonneg hb\n312:   calc\n313:     Int.ofNat (base.toNat ^ exponent.toNat) = ((base.toNat ^ exponent.toNat : Nat) : Int) := rfl\n314:     _ = (base.toNat : Int) ^ exponent.toNat := by push_cast; rfl\n315:     _ = base ^ exponent.toNat := by rw [hb_eq]\n316: \n317: /-- Integer specification when precondition is violated (raises `ValueError` in Python). -/\n318: @[reducible]\n319: def int_invalid_prop (base exponent : Int) : Prop :=\n320:   ¬ PreInt base exponent → myPowerInt base exponent = none\n321: \n322: theorem int_invalid_thm (base exponent : Int) : int_invalid_prop base exponent := by\n323:   unfold int_invalid_prop PreInt myPowerInt pre\n324:   intro hnot\n325:   have hcond : ¬ ((decide (base ≥ 0) && decide (exponent ≥ 0)) = true) := by\n326:     simp [hnot]\n327:   exact if_neg hcond\n328: \n329: /-! ## 5. Post-condition -/\n330: \n331: /-- Post-condition combining the specification properties of `myPower`. -/\n332: @[reducible]\n333: def Post_prop (base exponent : Nat) : Prop :=\n334:   eq_pow_prop base exponent ∧\n335:   exp_zero_prop base exponent ∧\n336:   zero_base_prop base exponent ∧\n337:   zero_zero_prop base exponent ∧\n338:   exp_one_prop base exponent ∧\n339:   one_base_prop base exponent ∧\n340:   succ_exp_prop base exponent ∧\n341:   nonneg_prop base exponent ∧\n342:   pos_prop base exponent ∧\n343:   zero_iff_prop base exponent ∧\n344:   one_iff_prop base exponent ∧\n345:   ge_base_prop base exponent ∧\n346:   gt_one_prop base exponent ∧\n347:   dvd_prop base exponent ∧\n348:   add_exp_prop base exponent 1 ∧\n349:   mul_base_prop base 1 exponent ∧\n350:   mul_exp_prop base exponent 1 ∧\n351:   mono_base_prop base (base + 1) exponent ∧\n352:   mono_exp_prop (base + 1) exponent (exponent + 1) ∧\n353:   strict_mono_exp_prop (base + 2) exponent (exponent + 1)\n354: \n355: /-- Post-condition for the integer precondition-checked function `myPowerInt`. -/\n356: @[reducible]\n357: def PostInt_prop (base exponent : Int) : Prop :=\n358:   int_valid_prop base exponent ∧ int_invalid_prop base exponent\n359: \n360: set_option synthInstance.maxSize 512 in\n361: instance (base exponent : Nat) : Decidable (Post_prop base exponent) :=\n362:   inferInstance\n363: \n364: instance (base exponent : Int) : Decidable (PostInt_prop base exponent) :=\n365:   inferInstance\n366: \n367: /-! ## 6. Property-Based Tests -/\n368: \n369: #eval Plausible.Testable.check (∀ base exponent : Nat, eq_pow_prop (base % 10) (exponent % 10))\n370: #eval Plausible.Testable.check (∀ base exponent : Nat, exp_zero_prop (base % 10) (exponent % 10))\n371: #eval Plausible.Testable.check (∀ base exponent : Nat, zero_base_prop (base % 10) (exponent % 10))\n372: #eval Plausible.Testable.check (∀ base exponent : Nat, zero_zero_prop (base % 10) (exponent % 10))\n373: #eval Plausible.Testable.check (∀ base exponent : Nat, exp_one_prop (base % 10) (exponent % 10))\n374: #eval Plausible.Testable.check (∀ base exponent : Nat, one_base_prop (base % 10) (exponent % 10))\n375: #eval Plausible.Testable.check (∀ base exponent : Nat, succ_exp_prop (base % 10) (exponent % 10))\n376: #eval Plausible.Testable.check (∀ base exponent : Nat, nonneg_prop (base % 10) (exponent % 10))\n377: #eval Plausible.Testable.check (∀ base exponent : Nat, pos_prop (base % 10) (exponent % 10))\n378: #eval Plausible.Testable.check (∀ base exponent : Nat, zero_iff_prop (base % 10) (exponent % 10))\n379: #eval Plausible.Testable.check (∀ base exponent : Nat, one_iff_prop (base % 10) (exponent % 10))\n380: #eval Plausible.Testable.check (∀ base exponent : Nat, ge_base_prop (base % 10) (exponent % 10))\n381: #eval Plausible.Testable.check (∀ base exponent : Nat, gt_one_prop (base % 10) (exponent % 10))\n382: #eval Plausible.Testable.check (∀ base exponent : Nat, dvd_prop (base % 10) (exponent % 10))\n383: #eval Plausible.Testable.check (∀ base e1 e2 : Nat, add_exp_prop (base % 8) (e1 % 6) (e2 % 6))\n384: #eval Plausible.Testable.check (∀ b1 b2 exponent : Nat, mul_base_prop (b1 % 8) (b2 % 8) (exponent % 6))\n385: #eval Plausible.Testable.check (∀ base e1 e2 : Nat, mul_exp_prop (base % 6) (e1 % 5) (e2 % 5))\n386: #eval Plausible.Testable.check (∀ b1 b2 exponent : Nat, mono_base_prop (b1 % 8) (b2 % 8) (exponent % 6))\n387: #eval Plausible.Testable.check (∀ base e1 e2 : Nat, mono_exp_prop (base % 8) (e1 % 6) (e2 % 6))\n388: #eval Plausible.Testable.check (∀ base e1 e2 : Nat, strict_mono_exp_prop (base % 8) (e1 % 6) (e2 % 6))\n389: #eval Plausible.Testable.check (∀ base exponent : Nat, decide (Post_prop (base % 8) (exponent % 6)) = true)\n390: #eval Plausible.Testable.check (∀ base exponent : Int, decide (int_valid_prop (base % 8) (exponent % 6)) = true)\n391: #eval Plausible.Testable.check (∀ base exponent : Int, decide (int_invalid_prop (base % 8) (exponent % 6)) = true)\n392: #eval Plausible.Testable.check (∀ base exponent : Int, decide (PostInt_prop (base % 8) (exponent % 6)) = true)\n393: \n394: -- Bounded exhaustive property-based tests over small inputs\n395: example : (List.range 10).all (fun b => (List.range 8).all (fun e => decide (eq_pow_prop b e))) = true := by native_decide\n396: example : (List.range 10).all (fun b => (List.range 8).all (fun e => decide (exp_zero_prop b e))) = true := by native_decide\n397: example : (List.range 10).all (fun b => (List.range 8).all (fun e => decide (zero_base_prop b e))) = true := by native_decide\n398: example : (List.range 10).all (fun b => (List.range 8).all (fun e => decide (zero_zero_prop b e))) = true := by native_decide\n399: example : (List.range 10).all (fun b => (List.range 8).all (fun e => decide (exp_one_prop b e))) = true := by native_decide\n400: example : (List.range 10).all (fun b => (List.range 8).all (fun e => decide (one_base_prop b e))) = true := by native_decide\n401: example : (List.range 10).all (fun b => (List.range 8).all (fun e => decide (succ_exp_prop b e))) = true := by native_decide\n402: example : (List.range 10).all (fun b => (List.range 8).all (fun e => decide (nonneg_prop b e))) = true := by native_decide\n403: example : (List.range 10).all (fun b => (List.range 8).all (fun e => decide (pos_prop b e))) = true := by native_decide\n404: example : (List.range 10).all (fun b => (List.range 8).all (fun e => decide (zero_iff_prop b e))) = true := by native_decide\n405: example : (List.range 10).all (fun b => (List.range 8).all (fun e => decide (one_iff_prop b e))) = true := by native_decide\n406: example : (List.range 10).all (fun b => (List.range 8).all (fun e => decide (ge_base_prop b e))) = true := by native_decide\n407: example : (List.range 10).all (fun b => (List.range 8).all (fun e => decide (gt_one_prop b e))) = true := by native_decide\n408: example : (List.range 10).all (fun b => (List.range 8).all (fun e => decide (dvd_prop b e))) = true := by native_decide\n409: example : (List.range 6).all (fun b => (List.range 5).all (fun e1 => (List.range 5).all (fun e2 => decide (add_exp_prop b e1 e2)))) = true := by native_decide\n410: example : (List.range 6).all (fun b1 => (List.range 6).all (fun b2 => (List.range 5).all (fun e => decide (mul_base_prop b1 b2 e)))) = true := by native_decide\n411: example : (List.range 5).all (fun b => (List.range 4).all (fun e1 => (List.range 4).all (fun e2 => decide (mul_exp_prop b e1 e2)))) = true := by native_decide\n412: example : (List.range 6).all (fun b1 => (List.range 6).all (fun b2 => (List.range 5).all (fun e => decide (mono_base_prop b1 b2 e)))) = true := by native_decide\n413: example : (List.range 6).all (fun b => (List.range 5).all (fun e1 => (List.range 5).all (fun e2 => decide (mono_exp_prop b e1 e2)))) = true := by native_decide\n414: example : (List.range 6).all (fun b => (List.range 5).all (fun e1 => (List.range 5).all (fun e2 => decide (strict_mono_exp_prop b e1 e2)))) = true := by native_decide\n415: example : (List.range 8).all (fun b => (List.range 6).all (fun e => decide (Post_prop b e))) = true := by native_decide\n416: \n417: /-! ## 7. Correctness Theorem -/\n418: \n419: /-- Main correctness theorem: `Pre` implies `Post_prop` for all natural number inputs. -/\n420: theorem myPower_correct (base exponent : Nat) (_hpre : Pre base exponent) :\n421:     Post_prop base exponent := by\n422:   unfold Post_prop\n423:   refine ⟨eq_pow_thm base exponent,\n424:           exp_zero_thm base exponent,\n425:           zero_base_thm base exponent,\n426:           zero_zero_thm base exponent,\n427:           exp_one_thm base exponent,\n428:           one_base_thm base exponent,\n429:           succ_exp_thm base exponent,\n430:           nonneg_thm base exponent,\n431:           pos_thm base exponent,\n432:           zero_iff_thm base exponent,\n433:           one_iff_thm base exponent,\n434:           ge_base_thm base exponent,\n435:           gt_one_thm base exponent,\n436:           dvd_thm base exponent,\n437:           add_exp_thm base exponent 1,\n438:           mul_base_thm base 1 exponent,\n439:           mul_exp_thm base exponent 1,\n440:           mono_base_thm base (base + 1) exponent,\n441:           mono_exp_thm (base + 1) exponent (exponent + 1),\n442:           strict_mono_exp_thm (base + 2) exponent (exponent + 1)⟩\n443: \n444: /-- Main correctness theorem for the integer version `myPowerInt`. -/\n445: theorem myPowerInt_correct (base exponent : Int) :\n446:     PostInt_prop base exponent := by\n447:   exact ⟨int_valid_thm base exponent, int_invalid_thm base exponent⟩\n448: \n449: /-! ## 8. Imperative Implementation -/\n450: \n451: /-- Imperative implementation of `myPower` using `Id.run do` and mutable state. -/\n452: def myPowerImp (base exponent : Nat) : Nat := Id.run do\n453:   if exponent == 0 then\n454:     return 1\n455:   let mut result : Nat := 1\n456:   for _ in List.range exponent do\n457:     result := result * base\n458:   return result\n459: \n460: /-- Imperative implementation of `myPowerInt` on integers with precondition check. -/\n461: def myPowerIntImp (base exponent : Int) : Option Int := Id.run do\n462:   if !pre base exponent then\n463:     return none\n464:   let expNat := exponent.toNat\n465:   let baseNat := base.toNat\n466:   if expNat == 0 then\n467:     return some 1\n468:   let mut result : Nat := 1\n469:   for _ in List.range expNat do\n470:     result := result * baseNat\n471:   return some (Int.ofNat result)\n472: \n473: /-! ## 9. Imperative Tests -/\n474: \n475: #eval myPowerImp 2 3\n476: #eval myPowerImp 0 0\n477: #eval myPowerImp 0 5\n478: #eval myPowerImp 5 0\n479: #eval myPowerImp 1 10\n480: #eval myPowerImp 3 4\n481: #eval myPowerIntImp 2 3\n482: #eval myPowerIntImp 0 0\n483: #eval myPowerIntImp (-1) 2\n484: #eval myPowerIntImp 2 (-1)\n485: \n486: example : myPowerImp 2 3 = 8 := by native_decide\n487: example : myPowerImp 0 0 = 1 := by native_decide\n488: example : myPowerImp 5 0 = 1 := by native_decide\n489: example : myPowerImp 0 5 = 0 := by native_decide\n490: example : myPowerImp 1 10 = 1 := by native_decide\n491: example : myPowerImp 3 4 = 81 := by native_decide\n492: \n493: example : myPowerIntImp 2 3 = some 8 := by native_decide\n494: example : myPowerIntImp 0 0 = some 1 := by native_decide\n495: example : myPowerIntImp 0 5 = some 0 := by native_decide\n496: example : myPowerIntImp 5 0 = some 1 := by native_decide\n497: example : myPowerIntImp (-1) 2 = none := by native_decide\n498: example : myPowerIntImp 2 (-1) = none := by native_decide\n499: \n500: -- Property-based test for functional-imperative equivalence\n501: #eval Plausible.Testable.check (∀ base exponent : Nat, myPower (base % 10) (exponent % 10) = myPowerImp (base % 10) (exponent % 10))\n502: #eval Plausible.Testable.check (∀ base exponent : Int, myPowerInt (base % 10) (exponent % 10) = myPowerIntImp (base % 10) (exponent % 10))\n503: \n504: /-! ## 10. Equivalence Theorem -/\n505: \n506: /-- Helper lemma characterizing the fold over a list multiplying by `base`. -/\n507: theorem foldl_mul_base (xs : List α) (acc base : Nat) :\n508:     xs.foldl (fun r _ => r * base) acc = acc * base ^ xs.length := by\n509:   induction xs generalizing acc with\n510:   | nil => simp\n511:   | cons _ tl ih =>\n512:     simp only [List.foldl_cons, List.length_cons, ih]\n513:     rw [Nat.pow_succ', ← Nat.mul_assoc]\n514: \n515: /-- Functional and imperative implementations of `myPower` are equivalent. -/\n516: theorem myPower_equiv (base exponent : Nat) :\n517:     myPower base exponent = myPowerImp base exponent := by\n518:   rw [myPower_eq_pow]\n519:   unfold myPowerImp\n520:   cases exponent with\n521:   | zero => rfl\n522:   | succ n =>\n523:     simp [foldl_mul_base]\n524: \n525: /-- Functional and imperative implementations of `myPowerInt` are equivalent. -/\n526: theorem myPowerInt_equiv (base exponent : Int) :\n527:     myPowerInt base exponent = myPowerIntImp base exponent := by\n528:   unfold myPowerInt myPowerIntImp\n529:   by_cases h : pre base exponent = true\n530:   · simp only [h, Bool.not_true, Bool.false_eq_true, ↓reduceIte]\n531:     rw [myPower_equiv base.toNat exponent.toNat]\n532:     unfold myPowerImp\n533:     cases exponent.toNat with\n534:     | zero => rfl\n535:     | succ n => rfl\n536:   · have hf : pre base exponent = false := Bool.eq_false_iff.mpr h\n537:     simp [hf]\n538: \n539: end «19_MyPower»"}
