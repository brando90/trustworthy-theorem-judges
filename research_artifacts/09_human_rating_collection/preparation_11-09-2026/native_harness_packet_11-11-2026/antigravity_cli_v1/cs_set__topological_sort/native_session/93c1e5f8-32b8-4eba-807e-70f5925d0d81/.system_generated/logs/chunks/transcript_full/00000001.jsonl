st Nat)) : Prop :=\n417:   malformed_none_prop graph ∧\n418:   soundness_prop graph ∧\n419:   vertex_coverage_prop graph ∧\n420:   edge_ordering_prop graph ∧\n421:   reachability_ordering_prop graph ∧\n422:   completeness_prop graph ∧\n423:   empty_graph_prop graph ∧\n424:   forward_dag_prop graph ∧\n425:   edgeless_graph_prop graph ∧\n426:   cycle_none_prop graph ∧\n427:   self_loop_none_prop graph ∧\n428:   two_cycle_none_prop graph\n429: \n430: /-! ## 9. Property-Based Tests (PBTs) -/\n431: \n432: /-- Representative sample of graphs (empty, edgeless, connected DAGs, disconnected DAGs,\n433: cycles, self-loops, and malformed adjacency lists) for bounded PBTs. -/\n434: def sample_graphs : List (List (List Nat)) :=\n435:   [ [],\n436:     [[]],\n437:     [[0]],\n438:     [[1]],\n439:     [[2]],\n440:     [[], []],\n441:     [[1], []],\n442:     [[], [0]],\n443:     [[1], [0]],\n444:     [[0], []],\n445:     [[], [1]],\n446:     [[1, 2], []],\n447:     [[], [], []],\n448:     [[1], [2], []],\n449:     [[2], [], []],\n450:     [[], [0], [1]],\n451:     [[1, 2], [2], []],\n452:     [[1], [2], [0]],\n453:     [[1, 2], [3], [3], []],\n454:     [[3], [0], [1], [2]] ]\n455: \n456: /-- Executable boolean check for `malformed_none_prop`. -/\n457: def check_malformed_none (graph : List (List Nat)) : Bool :=\n458:   if !pre graph then topological_sort graph == none else true\n459: \n460: /-- Executable boolean check for `soundness_prop`. -/\n461: def check_soundness (graph : List (List Nat)) : Bool :=\n462:   match topological_sort graph with\n463:   | none => true\n464:   | some order => pre graph && is_topological_order graph order\n465: \n466: /-- Executable boolean check for `vertex_coverage_prop`. -/\n467: def check_vertex_coverage (graph : List (List Nat)) : Bool :=\n468:   match topological_sort graph with\n469:   | none => true\n470:   | some order =>\n471:     order.mergeSort == List.range graph.length &&\n472:     order.length == graph.length &&\n473:     decide order.Nodup &&\n474:     (List.range graph.length).all (fun v => decide (v ∈ order)) &&\n475:     order.all (fun v => decide (v < graph.length))\n476: \n477: /-- Executable boolean check for `edge_ordering_prop`. -/\n478: def check_edge_ordering (graph : List (List Nat)) : Bool :=\n479:   match topological_sort graph with\n480:   | none => true\n481:   | some order =>\n482:     (List.range graph.length).all (fun u =>\n483:       (graph[u]!).all (fun v => decide (order.idxOf u < order.idxOf v)))\n484: \n485: /-- Executable boolean check for 2-step `reachability_ordering_prop`. -/\n486: def check_reachability_ordering (graph : List (List Nat)) : Bool :=\n487:   match topological_sort graph with\n488:   | none => true\n489:   | some order =>\n490:     (List.range graph.length).all (fun u =>\n491:       (graph[u]!).all (fun w =>\n492:         decide (order.idxOf u < order.idxOf w) &&\n493:         (if w < graph.length then\n494:           (graph[w]!).all (fun v => decide (order.idxOf u < order.idxOf v))\n495:         else true)))\n496: \n497: /-- Executable boolean check for `completeness_prop`. -/\n498: def check_completeness (graph : List (List Nat)) : Bool :=\n499:   let has_valid_perm :=\n500:     (List.range graph.length).permutations.any (fun cand => is_topological_order graph cand)\n501:   match topological_sort graph with\n502:   | none => !has_valid_perm\n503:   | some order => has_valid_perm && is_topological_order graph order\n504: \n505: /-- Executable boolean check for `empty_graph_prop`. -/\n506: def check_empty_graph (graph : List (List Nat)) : Bool :=\n507:   if graph.isEmpty then topological_sort graph == some [] else true\n508: \n509: /-- Executable boolean check for `forward_dag_prop`. -/\n510: def check_forward_dag (graph : List (List Nat)) : Bool :=\n511:   let is_forward :=\n512:     pre graph &&\n513:     (List.range graph.length).all (fun u => (graph[u]!).all (fun v => decide (u < v)))\n514:   if is_forward then topological_sort graph == some (List.range graph.length) else true\n515: \n516: /-- Executable boolean check for `edgeless_graph_prop`. -/\n517: def check_edgeless_graph (graph : List (List Nat)) : Bool :=\n518:   if graph.all List.isEmpty then\n519:     topological_sort graph == some (List.range graph.length)\n520:   else\n521:     true\n522: \n523: /-- Executable boolean check for `self_loop_none_prop`. -/\n524: def check_self_loop_none (graph : List (List Nat)) : Bool :=\n525:   let has_self_loop :=\n526:     (List.range graph.length).any (fun u => decide (u ∈ graph[u]!))\n527:   if has_self_loop then topological_sort graph == none else true\n528: \n529: /-- Executable boolean check for `two_cycle_none_prop`. -/\n530: def check_two_cycle_none (graph : List (List Nat)) : Bool :=\n531:   let has_two_cycle :=\n532:     (List.range graph.length).any (fun u =>\n533:       (List.range graph.length).any (fun v =>\n534:         decide (v ∈ graph[u]! ∧ u ∈ graph[v]!)))\n535:   if has_two_cycle then topological_sort graph == none else true\n536: \n537: /-- Executable boolean check for `cycle_none_prop` (up to 3-step cycles). -/\n538: def check_cycle_none (graph : List (List Nat)) : Bool :=\n539:   let has_short_cycle :=\n540:     (List.range graph.length).any (fun u =>\n541:       (graph[u]!).any (fun v =>\n542:         decide (v == u) ||\n543:         (if v < graph.length then\n544:           (graph[v]!).any (fun w =>\n545:             decide (w == u) ||\n546:             (if w < graph.length then (graph[w]!).any (fun z => decide (z == u)) else false))\n547:         else false)))\n548:   if has_short_cycle then topological_sort graph == none else true\n549: \n550: /-- Executable boolean check for `Post_prop`. -/\n551: def check_post (graph : List (List Nat)) : Bool :=\n552:   check_malformed_none graph &&\n553:   check_soundness graph &&\n554:   check_vertex_coverage graph &&\n555:   check_edge_ordering graph &&\n556:   check_reachability_ordering graph &&\n557:   check_completeness graph &&\n558:   check_empty_graph graph &&\n559:   check_forward_dag graph &&\n560:   check_edgeless_graph graph &&\n561:   check_cycle_none graph &&\n562:   check_self_loop_none graph &&\n563:   check_two_cycle_none graph\n564: \n565: -- Bounded PBTs over `sample_graphs`\n566: example : sample_graphs.all check_malformed_none = true := by native_decide\n567: example : sample_graphs.all check_soundness = true := by native_decide\n568: example : sample_graphs.all check_vertex_coverage = true := by native_decide\n569: example : sample_graphs.all check_edge_ordering = true := by native_decide\n570: example : sample_graphs.all check_reachability_ordering = true := by native_decide\n571: example : sample_graphs.all check_completeness = true := by native_decide\n572: example : sample_graphs.all check_empty_graph = true := by native_decide\n573: example : sample_graphs.all check_forward_dag = true := by native_decide\n574: example : sample_graphs.all check_edgeless_graph = true := by native_decide\n575: example : sample_graphs.all check_cycle_none = true := by native_decide\n576: example : sample_graphs.all check_self_loop_none = true := by native_decide\n577: example : sample_graphs.all check_two_cycle_none = true := by native_decide\n578: example : sample_graphs.all check_post = true := by native_decide\n579: \n580: -- Randomized PBTs using Plausible (size-bounded to keep factorial permutation search fast)\n581: #eval Plausible.Testable.check (∀ g : List (List Nat), check_malformed_none (g.take 4) = true) { maxSize := 4 }\n582: #eval Plausible.Testable.check (∀ g : List (List Nat), check_soundness (g.take 4) = true) { maxSize := 4 }\n583: #eval Plausible.Testable.check (∀ g : List (List Nat), check_vertex_coverage (g.take 4) = true) { maxSize := 4 }\n584: #eval Plausible.Testable.check (∀ g : List (List Nat), check_edge_ordering (g.take 4) = true) { maxSize := 4 }\n585: #eval Plausible.Testable.check (∀ g : List (List Nat), check_reachability_ordering (g.take 4) = true) { maxSize := 4 }\n586: #eval Plausible.Testable.check (∀ g : List (List Nat), check_completeness (g.take 4) = true) { maxSize := 4 }\n587: #eval Plausible.Testable.check (∀ g : List (List Nat), check_empty_graph (g.take 4) = true) { maxSize := 4 }\n588: #eval Plausible.Testable.check (∀ g : List (List Nat), check_forward_dag (g.take 4) = true) { maxSize := 4 }\n589: #eval Plausible.Testable.check (∀ g : List (List Nat), check_edgeless_graph (g.take 4) = true) { maxSize := 4 }\n590: #eval Plausible.Testable.check (∀ g : List (List Nat), check_cycle_none (g.take 4) = true) { maxSize := 4 }\n591: #eval Plausible.Testable.check (∀ g : List (List Nat), check_self_loop_none (g.take 4) = true) { maxSize := 4 }\n592: #eval Plausible.Testable.check (∀ g : List (List Nat), check_two_cycle_none (g.take 4) = true) { maxSize := 4 }\n593: #eval Plausible.Testable.check (∀ g : List (List Nat), check_post (g.take 4) = true) { maxSize := 4 }\n594: \n595: /-! ## 10. Correctness Theorem (`Pre -> Post`) -/\n596: \n597: /-- Unconditional post-condition theorem holding for all graphs. -/\n598: theorem topological_sort_post (graph : List (List Nat)) : Post_prop graph :=\n599:   ⟨malformed_none_thm graph,\n600:    soundness_thm graph,\n601:    vertex_coverage_thm graph,\n602:    edge_ordering_thm graph,\n603:    reachability_ordering_thm graph,\n604:    completeness_thm graph,\n605:    empty_graph_thm graph,\n606:    forward_dag_thm graph,\n607:    edgeless_graph_thm graph,\n608:    cycle_none_thm graph,\n609:    self_loop_none_thm graph,\n610:    two_cycle_none_thm graph⟩"}
{"step_index":95,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-16T21:47:50Z","model":"gemini-4-argon-high","input_tokens":4369,"cache_read_tokens":63233,"output_tokens":2143,"thinking":"First, the task requires adding several properties and theorems to the specified file. These include vertex count and index bijection properties, and permutation-related propositions. Next, add the proof bodies (PB) for each of these.\n\n\n","tool_calls":[{"name":"edit_file","args":{"Path":"/home/user/lean_project/Veribench/topological_sort.lean","Replacement":"/-- Property 12: Two-cycle impossibility — if any two vertices have mutual edges between them,\n`topological_sort graph = none`. -/\ndef two_cycle_none_prop (graph : List (List Nat)) : Prop :=\n  (∃ (u v : Nat) (hu : u < graph.length) (hv : v < graph.length),\n    v ∈ graph[u] ∧ u ∈ graph[v]) →\n  topological_sort graph = none\n\ntheorem two_cycle_none_thm (graph : List (List Nat)) : two_cycle_none_prop graph := by\n  rintro ⟨u, v, hu, hv, huv, hvu⟩\n  apply cycle_none_thm graph\n  exact ⟨u, Relation.TransGen.tail (Relation.TransGen.single ⟨hu, huv⟩) ⟨hv, hvu⟩⟩\n\n/-- Property 13: Unique vertex count — in any returned ordering, every vertex `v < graph.length`\nappears with multiplicity `1`, and every `v ≥ graph.length` appears with multiplicity `0`. -/\ndef unique_vertex_count_prop (graph : List (List Nat)) : Prop :=\n  ∀ order, topological_sort graph = some order →\n    (∀ v < graph.length, order.count v = 1) ∧\n    (∀ v, graph.length ≤ v → order.count v = 0)\n\ntheorem unique_vertex_count_thm (graph : List (List Nat)) : unique_vertex_count_prop graph := by\n  intro order hsort\n  have ⟨hperm, _, _, _⟩ := vertex_coverage_thm graph order hsort\n  refine ⟨fun v hv => ?_, fun v hv => ?_⟩\n  · rw [hperm.count_eq]\n    exact List.count_eq_one_of_mem List.nodup_range (List.mem_range.mpr hv)\n  · rw [hperm.count_eq]\n    exact List.count_eq_zero.mpr (by simp [List.mem_range, Nat.not_lt.mpr hv])\n\n/-- Property 14: Position bijection — in any returned ordering, `order.idxOf` and indexing\ninto `order` form inverse bijections on `0 .. graph.length - 1`. -/\ndef index_bijection_prop (graph : List (List Nat)) : Prop :=\n  ∀ order, topological_sort graph = some order →\n    (∀ v < graph.length,\n      ∃ (hi : order.idxOf v < order.length), order[order.idxOf v] = v) ∧\n    (∀ (i : Nat) (hi : i < order.length),\n      order[i] < graph.length ∧ order.idxOf order[i] = i) ∧\n    (∀ u < graph.length, ∀ v < graph.length,\n      order.idxOf u = order.idxOf v → u = v)\n\ntheorem index_bijection_thm (graph : List (List Nat)) : index_bijection_prop graph := by\n  intro order hsort\n  have ⟨_, _, hnodup, hmem⟩ := vertex_coverage_thm graph order hsort\n  refine ⟨fun v hv => ?_, fun i hi => ?_, fun u hu v hv heq => ?_⟩\n  · have hvin : v ∈ order := (hmem v).mpr hv\n    have hidx : order.idxOf v < order.length := List.idxOf_lt_length_of_mem hvin\n    exact ⟨hidx, List.getElem_idxOf hidx⟩\n  · have hget_in : order[i] ∈ order := List.getElem_mem hi\n    exact ⟨(hmem order[i]).mp hget_in, List.idxOf_getElem hnodup i hi⟩\n  · have hu_in : u ∈ order := (hmem u).mpr hu\n    have hv_in : v ∈ order := (hmem v).mpr hv\n    have h1 : order.idxOf u < order.length := List.idxOf_lt_length_of_mem hu_in\n    have h2 : order.idxOf v < order.length := List.idxOf_lt_length_of_mem hv_in\n    have hg1 := List.getElem_idxOf h1\n    have hg2 := List.getElem_idxOf h2\n    rw [← hg1, ← hg2]\n    simp [heq]\n\n/-- Property 15: First-permutation selection — any returned ordering is the first candidate\nin `(List.range graph.length).permutations` satisfying `is_topological_order graph`. -/\ndef first_permutation_prop (graph : List (List Nat)) : Prop :=\n  ∀ order, topological_sort graph = some order →\n    ∃ as bs,\n      (List.range graph.length).permutations = as ++ order :: bs ∧\n      is_topological_order graph order = true ∧\n      ∀ cand ∈ as, is_topological_order graph cand = false ∧ ¬ IsTopologicalOrder graph cand\n\ntheorem first_permutation_thm (graph : List (List Nat)) : first_permutation_prop graph := by\n  intro order hsort\n  have ⟨hPre, _, _⟩ := soundness_thm graph order hsort\n  have hpre : pre graph = true := (pre_iff_Pre graph).mpr hPre\n  unfold topological_sort at hsort\n  simp only [hpre, Bool.not_true, Bool.false_eq_true, ↓reduceIte,\n    List.find?_eq_some_iff_append] at hsort\n  rcases hsort with ⟨htopo, as, bs, hperm_eq, hbefore⟩\n  refine ⟨as, bs, hperm_eq, htopo, fun cand hcand => ?_⟩\n  have hfalse : is_topological_order graph cand = false := by\n    simpa using hbefore cand hcand\n  refine ⟨hfalse, fun hCandTopo => ?_⟩\n  have htrue : is_topological_order graph cand = true :=\n    (is_topological_order_iff graph cand).mpr hCandTopo\n  rw [htrue] at hfalse\n  contradiction\n\n/-! ## 8. Post-condition -/\n\n/-- Post-condition combining all core behavioral properties of `topological_sort`. -/\ndef Post_prop (graph : List (List Nat)) : Prop :=\n  malformed_none_prop graph ∧\n  soundness_prop graph ∧\n  vertex_coverage_prop graph ∧\n  edge_ordering_prop graph ∧\n  reachability_ordering_prop graph ∧\n  completeness_prop graph ∧\n  empty_graph_prop graph ∧\n  forward_dag_prop graph ∧\n  edgeless_graph_prop graph ∧\n  cycle_none_prop graph ∧\n  self_loop_none_prop graph ∧\n  two_cycle_none_prop graph ∧\n  unique_vertex_count_prop graph ∧\n  index_bijection_prop graph ∧\n  first_permutation_prop graph","Target":"/-- Property 12: Two-cycle impossibility — if any two vertices have mutual edges between them,\n`topological_sort graph = none`. -/\ndef two_cycle_none_prop (graph : List (List Nat)) : Prop :=\n  (∃ (u v : Nat) (hu : u < graph.length) (hv : v < graph.length),\n    v ∈ graph[u] ∧ u ∈ graph[v]) →\n  topological_sort graph = none\n\ntheorem two_cycle_none_thm (graph : List (List Nat)) : two_cycle_none_prop graph := by\n  rintro ⟨u, v, hu, hv, huv, hvu⟩\n  apply cycle_none_thm graph\n  exact ⟨u, Relation.TransGen.tail (Relation.TransGen.single ⟨hu, huv⟩) ⟨hv, hvu⟩⟩\n\n/-! ## 8. Post-condition -/\n\n/-- Post-condition combining all core behavioral properties of `topological_sort`. -/\ndef Post_prop (graph : List (List Nat)) : Prop :=\n  malformed_none_prop graph ∧\n  soundness_prop graph ∧\n  vertex_coverage_prop graph ∧\n  edge_ordering_prop graph ∧\n  reachability_ordering_prop graph ∧\n  completeness_prop graph ∧\n  empty_graph_prop graph ∧\n  forward_dag_prop graph ∧\n  edgeless_graph_prop graph ∧\n  cycle_none_prop graph ∧\n  self_loop_none_prop graph ∧\n  two_cycle_none_prop graph"}}]}
