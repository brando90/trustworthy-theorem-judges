ist.reverse_append]\n  rfl\n\n#check @heapify_imp\n\nend heap_sort","Target":"example : heap_sort_imp [64, 34, 25, 12, 22, 11, 90, 88, 76, 50, 42] =\n    [11, 12, 22, 25, 34, 42, 50, 64, 76, 88, 90] := by native_decide\n\nend heap_sort"}}]}
