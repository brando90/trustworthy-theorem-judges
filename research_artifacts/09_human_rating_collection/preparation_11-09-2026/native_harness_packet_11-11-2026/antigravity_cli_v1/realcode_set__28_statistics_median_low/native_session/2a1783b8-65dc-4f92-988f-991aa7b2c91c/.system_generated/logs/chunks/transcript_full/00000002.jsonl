rk_eq_median_low]\n396:   unfold median_low\n397:   rw [mergeSort_eq_of_perm hperm]\n398: \n399: /-- Property 12: On a single-element list `[x]`, `benchmark_median_low` returns `some x`. -/\n400: @[reducible]\n401: def singleton_prop (x : Int) : Prop :=\n402:   benchmark_median_low [x] = some x\n403: \n404: theorem singleton_thm (x : Int) : singleton_prop x := by\n405:   simp [singleton_prop, benchmark_median_low, median_low, pre]\n406: \n407: /-- Property 13: On a two-element list `[x, y]`, `benchmark_median_low` returns `some (min x y)`. -/\n408: @[reducible]\n409: def pair_prop (x y : Int) : Prop :=\n410:   benchmark_median_low [x, y] = some (min x y)\n411: \n412: theorem pair_thm (x y : Int) : pair_prop x y := by\n413:   unfold pair_prop benchmark_median_low median_low pre\n414:   simp only [List.isEmpty_cons, Bool.not_false, Bool.not_true]\n415:   change (let sorted := [x, y].mergeSort (fun a b : Int => decide (a ≤ b));\n416:     let n := sorted.length;\n417:     if n = 0 then none else if n % 2 = 1 then sorted[n / 2]? else sorted[n / 2 - 1]?) = some (min x y)\n418:   by_cases hxy : x ≤ y\n419:   · have hd : decide (x ≤ y) = true := decide_eq_true hxy\n420:     simp [List.mergeSort, hd, min_eq_left hxy]\n421:   · have hd : decide (x ≤ y) = false := decide_eq_false hxy\n422:     have hyx : y ≤ x := by omega\n423:     simp [List.mergeSort, hd, min_eq_right hyx]\n424: \n425: /-- Property 14: On a non-empty constant list `List.replicate n v`, `benchmark_median_low` returns `some v`. -/\n426: @[reducible]\n427: def replicate_prop (n : Nat) (v : Int) : Prop :=\n428:   0 < n → benchmark_median_low (List.replicate n v) = some v\n429: \n430: theorem replicate_thm (n : Nat) (v : Int) :\n431:     replicate_prop n v := by\n432:   intro hn\n433:   have hpre : Pre (List.replicate n v) := by\n434:     simp [Pre]\n435:     omega\n436:   have hisSome := (nonempty_isSome_thm (List.replicate n v) hpre).1\n437:   rw [Option.isSome_iff_exists] at hisSome\n438:   rcases hisSome with ⟨m, hm⟩\n439:   have hmem := mem_thm (List.replicate n v) hpre m hm\n440:   rw [List.mem_replicate] at hmem\n441:   rcases hmem with ⟨_, rfl⟩\n442:   exact hm\n443: \n444: /-- Property 15: Translation equivariance: shifting every element by `c` shifts the low median by `c`. -/\n445: @[reducible]\n446: def shift_equivariant_prop (data : List Int) (c : Int) : Prop :=\n447:   benchmark_median_low (data.map (· + c)) = (benchmark_median_low data).map (· + c)\n448: \n449: theorem shift_equivariant_thm (data : List Int) (c : Int) :\n450:     shift_equivariant_prop data c := by\n451:   unfold shift_equivariant_prop\n452:   rw [benchmark_eq_median_low, benchmark_eq_median_low]\n453:   unfold median_low\n454:   dsimp only\n455:   have hmono : Monotone (fun x : Int => x + c) := fun a b hab => by dsimp; omega\n456:   rw [mergeSort_map_of_monotone data (· + c) hmono]\n457:   simp only [List.length_map]\n458:   split_ifs with h0 hodd\n459:   · rfl\n460:   · exact List.getElem?_map\n461:   · exact List.getElem?_map\n462: \n463: /-- Property 16: Non-negative scaling equivariance: scaling every element by `c ≥ 0`\n464:     scales the low median by `c`. -/\n465: @[reducible]\n466: def scale_nonneg_equivariant_prop (data : List Int) (c : Int) : Prop :=\n467:   0 ≤ c → benchmark_median_low (data.map (c * ·)) = (benchmark_median_low data).map (c * ·)\n468: \n469: theorem scale_nonneg_equivariant_thm (data : List Int) (c : Int) :\n470:     scale_nonneg_equivariant_prop data c := by\n471:   intro hc\n472:   rw [benchmark_eq_median_low, benchmark_eq_median_low]\n473:   unfold median_low\n474:   dsimp only\n475:   have hmono : Monotone (fun x : Int => c * x) := fun a b hab =>\n476:     Int.mul_le_mul_of_nonneg_left hab hc\n477:   rw [mergeSort_map_of_monotone data (c * ·) hmono]\n478:   simp only [List.length_map]\n479:   split_ifs with h0 hodd\n480:   · rfl\n481:   · exact List.getElem?_map\n482:   · exact List.getElem?_map\n483: \n484: /-- Property 17: If `data` is already sorted in non-decreasing order, `benchmark_median_low`\n485:     directly returns `data[(data.length - 1) / 2]?`. -/\n486: @[reducible]\n487: def already_sorted_prop (data : List Int) : Prop :=\n488:   List.Pairwise (· ≤ ·) data →\n489:     benchmark_median_low data = data[(data.length - 1) / 2]?\n490: \n491: theorem already_sorted_thm (data : List Int) (h : Pre data) :\n492:     already_sorted_prop data := by\n493:   intro hsorted\n494:   rw [unified_index_thm data h, mergeSort_eq_self_of_sorted hsorted]\n495: \n496: -- ============================================================================\n497: -- 8. Post-condition (`def Post_prop`) as conjunction of properties\n498: -- ============================================================================\n499: \n500: /-- Complete post-condition for `benchmark_median_low` on non-empty input `data`. -/\n501: @[reducible]\n502: def Post_prop (data : List Int) : Prop :=\n503:   nonempty_isSome_prop data ∧\n504:   unified_index_prop data ∧\n505:   odd_length_prop data ∧\n506:   even_length_prop data ∧\n507:   mem_prop data ∧\n508:   lower_half_prop data ∧\n509:   upper_half_prop data ∧\n510:   bounds_prop data ∧\n511:   sorted_idempotent_prop data ∧\n512:   already_sorted_prop data\n513: \n514: -- ============================================================================\n515: -- 9. Property-based tests (PBTs)\n516: -- ============================================================================\n517: \n518: /-- Sample datasets for bounded exhaustive/regression PBTs. -/\n519: def pbtTestLists : List (List Int) :=\n520:   [ [1, 3, 5],\n521:     [1, 2, 3, 4, 5, 6, 9],\n522:     [1, 3, 5, 7],\n523:     [1, 2, 3, 4, 5, 6],\n524:     [42],\n525:     [10, 20],\n526:     [20, 10],\n527:     [9, 1, 6, 2, 5, 4, 3],\n528:     [-5, -1, 0, 3, 7],\n529:     [-10, -5, 5, 10],\n530:     [0, 0, 0, 0],\n531:     [5, 4, 3, 2, 1, 0, -1, -2] ]\n532: \n533: -- PBT for empty_none_prop\n534: #eval Plausible.Testable.check (∀ data : List Int, empty_none_prop data)\n535: example : empty_none_prop [] := by native_decide\n536: \n537: -- PBT for unified_index_prop\n538: #eval Plausible.Testable.check (∀ x : Int, ∀ xs : List Int, unified_index_prop (x :: xs))\n539: example : pbtTestLists.all (fun data => decide (unified_index_prop data)) = true := by native_decide\n540: \n541: -- PBT for nonempty_isSome_prop\n542: #eval Plausible.Testable.check (∀ x : Int, ∀ xs : List Int, nonempty_isSome_prop (x :: xs))\n543: example : pbtTestLists.all (fun data => decide (nonempty_isSome_prop data)) = true := by native_decide\n544: \n545: -- PBT for odd_length_prop\n546: #eval Plausible.Testable.check (∀ x : Int, ∀ xs : List Int, odd_length_prop (x :: xs))\n547: example : pbtTestLists.all (fun data => decide (odd_length_prop data)) = true := by native_decide\n548: \n549: -- PBT for even_length_prop\n550: #eval Plausible.Testable.check (∀ x : Int, ∀ xs : List Int, even_length_prop (x :: xs))\n551: example : pbtTestLists.all (fun data => decide (even_length_prop data)) = true := by native_decide\n552: \n553: -- PBT for mem_prop\n554: #eval Plausible.Testable.check (∀ x : Int, ∀ xs : List Int, mem_prop (x :: xs))\n555: example : pbtTestLists.all (fun data => decide (mem_prop data)) = true := by native_decide\n556: \n557: -- PBT for lower_half_prop\n558: #eval Plausible.Testable.check (∀ x : Int, ∀ xs : List Int, lower_half_prop (x :: xs))\n559: example : pbtTestLists.all (fun data => decide (lower_half_prop data)) = true := by native_decide\n560: \n561: -- PBT for upper_half_prop\n562: #eval Plausible.Testable.check (∀ x : Int, ∀ xs : List Int, upper_half_prop (x :: xs))\n563: example : pbtTestLists.all (fun data => decide (upper_half_prop data)) = true := by native_decide\n564: \n565: -- PBT for bounds_prop\n566: #eval Plausible.Testable.check (∀ x : Int, ∀ xs : List Int, bounds_prop (x :: xs))\n567: example : pbtTestLists.all (fun data => decide (bounds_prop data)) = true := by native_decide\n568: \n569: -- PBT for sorted_idempotent_prop\n570: #eval Plausible.Testable.check (∀ data : List Int, sorted_idempotent_prop data)\n571: example : pbtTestLists.all (fun data => decide (sorted_idempotent_prop data)) = true := by native_decide\n572: \n573: -- PBT for perm_invariant_prop (testing reverse and mergeSort permutations)\n574: #eval Plausible.Testable.check (∀ data : List Int, benchmark_median_low data.reverse = benchmark_median_low data)\n575: example : pbtTestLists.all (fun data => decide (perm_invariant_prop data data.reverse)) = true := by native_decide\n576: \n577: -- PBT for singleton_prop\n578: #eval Plausible.Testable.check (∀ x : Int, singleton_prop x)\n579: example : (List.range 20).all (fun n => decide (singleton_prop (Int.ofNat n - 10))) = true := by native_decide\n580: \n581: -- PBT for pair_prop\n582: #eval Plausible.Testable.check (∀ x y : Int, pair_prop x y)\n583: example : (List.range 10).all (fun n => decide (pair_prop (Int.ofNat n) (5 - Int.ofNat n))) = true := by native_decide\n584: \n585: -- PBT for replicate_prop\n586: #eval Plausible.Testable.check (∀ n : Nat, ∀ v : Int, replicate_prop (n + 1) v)\n587: example : (List.range 10).all (fun n => decide (replicate_prop (n + 1) (Int.ofNat n - 5))) = true := by native_decide\n588: \n589: -- PBT for shift_equivariant_prop\n590: #eval Plausible.Testable.check (∀ data : List Int, ∀ c : Int, shift_equivariant_prop data c)\n591: example : pbtTestLists.all (fun data => decide (shift_equivariant_prop data 7)) = true := by native_decide\n592: \n593: -- PBT for scale_nonneg_equivariant_prop\n594: #eval Plausible.Testable.check (∀ data : List Int, ∀ n : Nat, scale_nonneg_equivariant_prop data (Int.ofNat n))\n595: example : pbtTestLists.all (fun data => decide (scale_nonneg_equivariant_prop data 3)) = true := by native_decide\n596: \n597: -- PBT for already_sorted_prop\n598: #eval Plausible.Testable.check (∀ x : Int, ∀ xs : List Int, already_sorted_prop (x :: xs))\n599: example : pbtTestLists.all (fun data => decide (already_sorted_prop data)) = true := by native_decide\n600: \n601: -- PBT for Post_prop\n602: #eval Plausible.Testable.check (∀ x : Int, ∀ xs : List Int, Post_prop (x :: xs))\n603: example : pbtTestLists.all (fun data => decide (Post_prop data)) = true := by native_decide\n604: \n605: -- ============================================================================\n606: -- 10. Correctness theorem: `Pre -> Post`\n607: -- ============================================================================\n608: \n609: /-- Main correctness theorem: for any input `data` satisfying `Pre data`,\n610:     `Post_prop data` holds. -/\n611: theorem benchmark_median_low_correct (data : List Int) (h : Pre data) :\n612:     Post_prop data :=\n613:   ⟨nonempty_isSome_thm data h,\n614:    unified_index_thm data h,\n615:    odd_length_thm data h,\n616:    even_length_thm data h,\n617:    mem_thm data h,\n618:    lower_half_thm data h,\n619:    upper_half_thm data h,\n620:    bounds_thm data h,\n621:    sorted_idempotent_thm data,\n622:    already_sorted_thm data h⟩\n623: \n624: -- ============================================================================\n625: -- 11. Imperative implementation using `Id.run do` with mutable state\n626: -- ============================================================================\n627: \n628: /-- Imperative implementation of `median_low` using `Id.run do` and mutable state. -/\n629: def median_low_imp (data : List Int) : Option Int := Id.run do\n630:   let mut sorted : List Int := data.mergeSort (· ≤ ·)\n631:   let mut n : Nat := sorted.length\n632:   let mut result : Option Int := none\n633:   if n = 0 then\n634:     result := none\n635:   else if n % 2 = 1 then\n636:     result := sorted[n / 2]?\n637:   else\n638:     result := sorted[n / 2 - 1]?\n639:   return result\n640: \n641: /-- Imperative implementation of `benchmark_median_low` using `Id.run do` and mutable state. -/\n642: def benchmark_median_low_imp (data : List Int) : Option Int := Id.run do\n643:   let mut valid : Bool := pre data\n644:   let mut result : Option Int := none\n645:   if !valid then\n646:     result := none\n647:   else\n648:     result := median_low_imp data\n649:   return result\n650: \n651: -- ============================================================================\n652: -- 12. Imperative tests\n653: -- ============================================================================\n654: \n655: -- 1. Odd number of elements\n656: example : benchmark_median_low_imp [1, 3, 5] = some 3 := by native_decide\n657: example : benchmark_median_low_imp [1, 2, 3, 4, 5, 6, 9] = some 4 := by native_decide\n658: \n659: -- 2. Even number of elements\n660: example : benchmark_median_low_imp [1, 3, 5, 7] = some 3 := by native_decide\n661: example : benchmark_median_low_imp [1, 2, 3, 4, 5, 6] = some 3 := by native_decide\n662: \n663: -- 3. Single value\n664: example : benchmark_median_low_imp [42] = some 42 := by native_decide\n665: \n666: -- 4. Two values\n667: example : benchmark_median_low_imp [10, 20] = some 10 := by native_decide\n668: \n669: -- 5. Unsorted input\n670: example : benchmark_median_low_imp [9, 1, 6, 2, 5, 4, 3] = some 4 := by native_decide\n671: \n672: -- 6. Negative values\n673: example : benchmark_median_low_imp [-5, -1, 0, 3, 7] = some 0 := by native_decide\n674: example : benchmark_median_low_imp [-10, -5, 5, 10] = some (-5) := by native_decide\n675: \n676: -- 7. Error cases\n677: example : benchmark_median_low_imp [] = none := by native_decide\n678: example : median_low_imp [] = none := by native_decide\n679: \n680: #eval benchmark_median_low_imp [1, 3, 5]\n681: #eval benchmark_median_low_imp [1, 3, 5, 7]\n682: #eval benchmark_median_low_imp [9, 1, 6, 2, 5, 4, 3]\n683: #eval benchmark_median_low_imp [-10, -5, 5, 10]\n684: #eval benchmark_median_low_imp []\n685: \n686: #eval Plausible.Testable.check (∀ data : List Int, benchmark_median_low data = benchmark_median_low_imp data)\n687: \n688: -- ============================================================================\n689: -- 13. Equivalence theorem: functional = imperative\n690: -- ============================================================================\n691: \n692: /-- Equivalence theorem between functional `median_low` and imperative `median_low_imp`. -/\n693: theorem median_low_equiv (data : List Int) :\n694:     median_low data = median_low_imp data := by\n695:   rfl\n696: \n697: /-- Equivalence theorem between functional `benchmark_median_low` and imperative `benchmark_median_low_imp`. -/\n698: theorem benchmark_median_low_equiv (data : List Int) :\n699:     benchmark_median_low data = benchmark_median_low_imp data := by\n700:   rfl\n701: \n702: end «28_statistics_median_low»"}
