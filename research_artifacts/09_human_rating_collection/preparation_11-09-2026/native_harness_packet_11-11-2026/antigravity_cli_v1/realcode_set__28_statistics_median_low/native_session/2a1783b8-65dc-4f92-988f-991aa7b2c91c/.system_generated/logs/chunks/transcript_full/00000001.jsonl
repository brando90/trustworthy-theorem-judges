{"step_index":83,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-16T22:41:43Z","content":"Created At: 2026-11-16T22:41:43Z\nCompleted At: 2026-11-16T22:41:43Z\nCreated At: 2026-11-16T22:41:43Z\nCompleted At: 2026-11-16T22:41:43Z\nShowing lines 1-702 of 702\n1: import Mathlib\n2: \n3: /-!\n4: # Low Median of Numeric Data (`statistics.median_low`)\n5: \n6: Formalization and verification of Python's `statistics.median_low` function in Lean 4.\n7: \n8: When the number of data points is odd, the middle value of the sorted data is returned.\n9: When the number of data points is even, the smaller of the two middle values is returned.\n10: When the input list is empty, `none` is returned (representing `StatisticsError`).\n11: -/\n12: \n13: namespace «28_statistics_median_low»\n14: \n15: -- ============================================================================\n16: -- 4. Implementation (functional definition)\n17: -- ============================================================================\n18: \n19: /-- Executable Boolean pre-condition: `true` iff `data` is non-empty. -/\n20: @[reducible]\n21: def pre (data : List Int) : Bool :=\n22:   !data.isEmpty\n23: \n24: /-- Return the low median of numeric data.\n25:     When the number of data points is odd, the middle value is returned.\n26:     When it is even, the smaller of the two middle values is returned.\n27:     Returns `none` for empty data (modeling `StatisticsError`). -/\n28: def median_low (data : List Int) : Option Int :=\n29:   let sorted := data.mergeSort (· ≤ ·)\n30:   let n := sorted.length\n31:   if n = 0 then\n32:     none\n33:   else if n % 2 = 1 then\n34:     sorted[n / 2]?\n35:   else\n36:     sorted[n / 2 - 1]?\n37: \n38: /-- Main function to be verified: checks `pre` and returns the low median of `data`,\n39:     or `none` (modeling `StatisticsError`) if `pre data` fails. -/\n40: def benchmark_median_low (data : List Int) : Option Int :=\n41:   if !pre data then\n42:     none\n43:   else\n44:     median_low data\n45: \n46: -- ============================================================================\n47: -- 5. Unit tests\n48: -- ============================================================================\n49: \n50: -- 1. Odd number of elements (returns middle value)\n51: example : benchmark_median_low [1, 3, 5] = some 3 := by native_decide\n52: example : benchmark_median_low [1, 2, 3, 4, 5, 6, 9] = some 4 := by native_decide\n53: \n54: -- 2. Even number of elements (returns smaller of two middle values)\n55: example : benchmark_median_low [1, 3, 5, 7] = some 3 := by native_decide\n56: example : benchmark_median_low [1, 2, 3, 4, 5, 6] = some 3 := by native_decide\n57: \n58: -- 3. Single value\n59: example : benchmark_median_low [42] = some 42 := by native_decide\n60: \n61: -- 4. Two values\n62: example : benchmark_median_low [10, 20] = some 10 := by native_decide\n63: \n64: -- 5. Unsorted input\n65: example : benchmark_median_low [9, 1, 6, 2, 5, 4, 3] = some 4 := by native_decide\n66: \n67: -- 6. Negative values\n68: example : benchmark_median_low [-5, -1, 0, 3, 7] = some 0 := by native_decide\n69: example : benchmark_median_low [-10, -5, 5, 10] = some (-5) := by native_decide\n70: \n71: -- 7. Error cases (empty list raises StatisticsError / returns none)\n72: example : benchmark_median_low [] = none := by native_decide\n73: example : median_low [] = none := by native_decide\n74: \n75: #eval benchmark_median_low [1, 3, 5]\n76: #eval benchmark_median_low [1, 2, 3, 4, 5, 6, 9]\n77: #eval benchmark_median_low [1, 3, 5, 7]\n78: #eval benchmark_median_low [1, 2, 3, 4, 5, 6]\n79: #eval benchmark_median_low [42]\n80: #eval benchmark_median_low [10, 20]\n81: #eval benchmark_median_low [9, 1, 6, 2, 5, 4, 3]\n82: #eval benchmark_median_low [-5, -1, 0, 3, 7]\n83: #eval benchmark_median_low [-10, -5, 5, 10]\n84: #eval benchmark_median_low []\n85: \n86: -- ============================================================================\n87: -- 6. Pre-condition predicate (`def Pre`)\n88: -- ============================================================================\n89: \n90: /-- Pre-condition proposition: `data` is a non-empty list of integers. -/\n91: @[reducible]\n92: def Pre (data : List Int) : Prop :=\n93:   data ≠ []\n94: \n95: theorem pre_iff_Pre (data : List Int) : pre data = true ↔ Pre data := by\n96:   simp [pre, Pre]\n97: \n98: -- ============================================================================\n99: -- 7. Property propositions (`def <name>_prop`) and theorems (`theorem <name>_thm`)\n100: -- ============================================================================\n101: \n102: /-! ### Helper Lemmas for Sorting and Order Statistics -/\n103: \n104: /-- Decidable instance for bounded option universal quantification `∀ m, o = some m → P m`. -/\n105: instance instDecidableForallOptionSome {α : Type*} {o : Option α} {P : α → Prop}\n106:     [DecidablePred P] : Decidable (∀ m, o = some m → P m) :=\n107:   match o with\n108:   | none => isTrue (by intro m h; cases h)\n109:   | some x =>\n110:     if hx : P x then\n111:       isTrue (by intro m h; cases h; exact hx)\n112:     else\n113:       isFalse (by intro h; exact hx (h x rfl))\n114: \n115: theorem benchmark_eq_median_low (data : List Int) :\n116:     benchmark_median_low data = median_low data := by\n117:   unfold benchmark_median_low median_low pre\n118:   cases data <;> simp\n119: \n120: lemma pairwise_mergeSort_int (l : List Int) :\n121:     List.Pairwise (· ≤ ·) (l.mergeSort (· ≤ ·)) := by\n122:   have h := List.sorted_mergeSort (le := fun a b : Int => decide (a ≤ b))\n123:     (by intro a b c; simp; omega)\n124:     (by intro a b; simp; omega)\n125:     l\n126:   simpa using h\n127: \n128: lemma mergeSort_eq_of_perm {l₁ l₂ : List Int} (h : l₁.Perm l₂) :\n129:     l₁.mergeSort (· ≤ ·) = l₂.mergeSort (· ≤ ·) := by\n130:   apply List.Perm.eq_of_sorted (le := (· ≤ ·))\n131:   · intro a b _ _ hab hba; omega\n132:   · exact pairwise_mergeSort_int l₁\n133:   · exact pairwise_mergeSort_int l₂\n134:   · exact (List.mergeSort_perm l₁ _).trans (h.trans (List.mergeSort_perm l₂ _).symm)\n135: \n136: lemma mergeSort_eq_self_of_sorted {l : List Int} (hs : List.Pairwise (· ≤ ·) l) :\n137:     l.mergeSort (· ≤ ·) = l := by\n138:   apply List.Perm.eq_of_sorted (le := (· ≤ ·))\n139:   · intro a b _ _ hab hba; omega\n140:   · exact pairwise_mergeSort_int l\n141:   · exact hs\n142:   · exact List.mergeSort_perm l _\n143: \n144: lemma mergeSort_map_of_monotone (l : List Int) (f : Int → Int) (hf : Monotone f) :\n145:     (l.map f).mergeSort (· ≤ ·) = (l.mergeSort (· ≤ ·)).map f := by\n146:   apply List.Perm.eq_of_sorted (le := (· ≤ ·))\n147:   · intro a b _ _ hab hba; omega\n148:   · exact pairwise_mergeSort_int (l.map f)\n149:   · exact (pairwise_mergeSort_int l).map f (fun a b hab => hf hab)\n150:   · exact (List.mergeSort_perm (l.map f) _).trans ((List.mergeSort_perm l _).symm.map f)\n151: \n152: lemma sorted_getElem_mono {l : List Int} (hs : List.Pairwise (· ≤ ·) l)\n153:     {i j : Nat} (hi : i < l.length) (hj : j < l.length) (hij : i ≤ j) :\n154:     l[i] ≤ l[j] := by\n155:   rcases Nat.eq_or_lt_of_le hij with rfl | hlt\n156:   · exact le_rfl\n157:   · exact (List.pairwise_iff_getElem.mp hs) i j hi hj hlt\n158: \n159: lemma countP_le_of_sorted {l : List Int} (hs : List.Pairwise (· ≤ ·) l)\n160:     {k : Nat} (hk : k < l.length) :\n161:     k + 1 ≤ l.countP (fun x => decide (x ≤ l[k])) := by\n162:   have hsplit : l = l.take (k + 1) ++ l.drop (k + 1) := (List.take_append_drop (k + 1) l).symm\n163:   have hcount : l.countP (fun x => decide (x ≤ l[k])) =\n164:       (l.take (k + 1)).countP (fun x => decide (x ≤ l[k])) +\n165:       (l.drop (k + 1)).countP (fun x => decide (x ≤ l[k])) :=\n166:     (congrArg (List.countP (fun x => decide (x ≤ l[k]))) hsplit).trans List.countP_append\n167:   have htake_all : (l.take (k + 1)).countP (fun x => decide (x ≤ l[k])) = (l.take (k + 1)).length := by\n168:     rw [List.countP_eq_length]\n169:     intro x hx\n170:     rw [List.mem_iff_getElem] at hx\n171:     rcases hx with ⟨i, hi, rfl⟩\n172:     simp only [List.length_take] at hi\n173:     rw [List.getElem_take]\n174:     simp only [decide_eq_true_eq]\n175:     exact sorted_getElem_mono hs (by omega) hk (by omega)\n176:   have hlen : (l.take (k + 1)).length = k + 1 := by simp; omega\n177:   omega\n178: \n179: lemma countP_ge_of_sorted {l : List Int} (hs : List.Pairwise (· ≤ ·) l)\n180:     {k : Nat} (hk : k < l.length) :\n181:     l.length - k ≤ l.countP (fun x => decide (l[k] ≤ x)) := by\n182:   have hsplit : l = l.take k ++ l.drop k := (List.take_append_drop k l).symm\n183:   have hcount : l.countP (fun x => decide (l[k] ≤ x)) =\n184:       (l.take k).countP (fun x => decide (l[k] ≤ x)) +\n185:       (l.drop k).countP (fun x => decide (l[k] ≤ x)) :=\n186:     (congrArg (List.countP (fun x => decide (l[k] ≤ x))) hsplit).trans List.countP_append\n187:   have hdrop_all : (l.drop k).countP (fun x => decide (l[k] ≤ x)) = (l.drop k).length := by\n188:     rw [List.countP_eq_length]\n189:     intro x hx\n190:     rw [List.mem_iff_getElem] at hx\n191:     rcases hx with ⟨i, hi, rfl⟩\n192:     simp only [List.length_drop] at hi\n193:     rw [List.getElem_drop]\n194:     simp only [decide_eq_true_eq]\n195:     exact sorted_getElem_mono hs hk (by omega) (by omega)\n196:   have hlen : (l.drop k).length = l.length - k := by simp\n197:   omega\n198: \n199: /-! ### Named Properties and Theorems -/\n200: \n201: /-- Property 1: On empty input, both `benchmark_median_low` and `median_low` return `none`. -/\n202: @[reducible]\n203: def empty_none_prop (data : List Int) : Prop :=\n204:   data = [] → benchmark_median_low data = none ∧ median_low data = none\n205: \n206: theorem empty_none_thm (data : List Int) : empty_none_prop data := by\n207:   intro h\n208:   subst h\n209:   simp [benchmark_median_low, median_low, pre]\n210: \n211: /-- Property 2: For non-empty input, `benchmark_median_low` returns the element at index\n212:     `(data.length - 1) / 2` of the sorted list. -/\n213: @[reducible]\n214: def unified_index_prop (data : List Int) : Prop :=\n215:   let sorted := data.mergeSort (· ≤ ·)\n216:   benchmark_median_low data = sorted[(data.length - 1) / 2]?\n217: \n218: theorem unified_index_thm (data : List Int) (h : Pre data) :\n219:     unified_index_prop data := by\n220:   unfold unified_index_prop\n221:   rw [benchmark_eq_median_low]\n222:   unfold median_low\n223:   dsimp only\n224:   have hlen_eq : (data.mergeSort (· ≤ ·)).length = data.length := List.length_mergeSort data\n225:   have hpos : 0 < data.length := List.length_pos_of_ne_nil h\n226:   rw [hlen_eq]\n227:   split_ifs with h0 hodd\n228:   · omega\n229:   · congr 1; omega\n230:   · congr 1; omega\n231: \n232: /-- Property 3: For non-empty input, `benchmark_median_low` always succeeds (`isSome = true`)\n233:     and agrees with `median_low`. -/\n234: @[reducible]\n235: def nonempty_isSome_prop (data : List Int) : Prop :=\n236:   (benchmark_median_low data).isSome = true ∧ benchmark_median_low data = median_low data\n237: \n238: theorem nonempty_isSome_thm (data : List Int) (h : Pre data) :\n239:     nonempty_isSome_prop data := by\n240:   refine ⟨?_, benchmark_eq_median_low data⟩\n241:   rw [unified_index_thm data h]\n242:   have hpos : 0 < data.length := List.length_pos_of_ne_nil h\n243:   have hlen_eq : (data.mergeSort (· ≤ ·)).length = data.length := List.length_mergeSort data\n244:   have hlt : (data.length - 1) / 2 < (data.mergeSort (· ≤ ·)).length := by omega\n245:   rw [List.getElem?_eq_getElem hlt]\n246:   rfl\n247: \n248: /-- Property 4: When the number of data points is odd, the middle value `sorted[n / 2]` is returned. -/\n249: @[reducible]\n250: def odd_length_prop (data : List Int) : Prop :=\n251:   let sorted := data.mergeSort (· ≤ ·)\n252:   data.length % 2 = 1 →\n253:     benchmark_median_low data = sorted[data.length / 2]?\n254: \n255: theorem odd_length_thm (data : List Int) (h : Pre data) :\n256:     odd_length_prop data := by\n257:   intro hodd\n258:   rw [unified_index_thm data h]\n259:   congr 1\n260:   omega\n261: \n262: /-- Property 5: When the number of data points is even, the lower middle value `sorted[n / 2 - 1]`\n263:     is returned, and it is less than or equal to the upper middle value `sorted[n / 2]`. -/\n264: @[reducible]\n265: def even_length_prop (data : List Int) : Prop :=\n266:   let sorted := data.mergeSort (· ≤ ·)\n267:   data.length % 2 = 0 →\n268:     benchmark_median_low data = sorted[data.length / 2 - 1]? ∧\n269:     (∀ m, benchmark_median_low data = some m → ∀ u, sorted[data.length / 2]? = some u → m ≤ u)\n270: \n271: theorem even_length_thm (data : List Int) (h : Pre data) :\n272:     even_length_prop data := by\n273:   intro heven\n274:   have hpos : 0 < data.length := List.length_pos_of_ne_nil h\n275:   have hlen_eq : (data.mergeSort (· ≤ ·)).length = data.length := List.length_mergeSort data\n276:   have hidx : (data.length - 1) / 2 = data.length / 2 - 1 := by omega\n277:   have heq : benchmark_median_low data = (data.mergeSort (· ≤ ·))[data.length / 2 - 1]? := by\n278:     rw [unified_index_thm data h, hidx]\n279:   refine ⟨heq, ?_⟩\n280:   intro m hm u hu\n281:   rw [heq] at hm\n282:   have hlt1 : data.length / 2 - 1 < (data.mergeSort (· ≤ ·)).length := by omega\n283:   have hlt2 : data.length / 2 < (data.mergeSort (· ≤ ·)).length := by omega\n284:   rw [List.getElem?_eq_getElem hlt1, Option.some.injEq] at hm\n285:   rw [List.getElem?_eq_getElem hlt2, Option.some.injEq] at hu\n286:   subst hm hu\n287:   exact sorted_getElem_mono (pairwise_mergeSort_int data) hlt1 hlt2 (by omega)\n288: \n289: /-- Property 6: The returned low median is always an element of the original input list `data`. -/\n290: @[reducible]\n291: def mem_prop (data : List Int) : Prop :=\n292:   ∀ m, benchmark_median_low data = some m → m ∈ data\n293: \n294: theorem mem_thm (data : List Int) (h : Pre data) :\n295:     mem_prop data := by\n296:   intro m hm\n297:   rw [unified_index_thm data h] at hm\n298:   have hmem_sorted : m ∈ data.mergeSort (· ≤ ·) := List.mem_of_getElem? hm\n299:   exact (List.mergeSort_perm data _).subset hmem_sorted\n300: \n301: /-- Property 7: At least `(data.length + 1) / 2` elements in `data` are `≤` the low median `m`. -/\n302: @[reducible]\n303: def lower_half_prop (data : List Int) : Prop :=\n304:   ∀ m, benchmark_median_low data = some m →\n305:     (data.length + 1) / 2 ≤ data.countP (fun x => decide (x ≤ m))\n306: \n307: theorem lower_half_thm (data : List Int) (h : Pre data) :\n308:     lower_half_prop data := by\n309:   intro m hm\n310:   rw [unified_index_thm data h] at hm\n311:   have hpos : 0 < data.length := List.length_pos_of_ne_nil h\n312:   have hlen_eq : (data.mergeSort (· ≤ ·)).length = data.length := List.length_mergeSort data\n313:   have hk : (data.length - 1) / 2 < (data.mergeSort (· ≤ ·)).length := by omega\n314:   rw [List.getElem?_eq_getElem hk, Option.some.injEq] at hm\n315:   subst hm\n316:   have hperm_count : data.countP (fun x => decide (x ≤ (data.mergeSort (· ≤ ·))[(data.length - 1) / 2])) =\n317:       (data.mergeSort (· ≤ ·)).countP (fun x => decide (x ≤ (data.mergeSort (· ≤ ·))[(data.length - 1) / 2])) :=\n318:     (List.mergeSort_perm data _).symm.countP_eq _\n319:   rw [hperm_count]\n320:   have hle := countP_le_of_sorted (pairwise_mergeSort_int data) hk\n321:   omega\n322: \n323: /-- Property 8: At least `data.length / 2 + 1` elements in `data` are `≥` the low median `m`. -/\n324: @[reducible]\n325: def upper_half_prop (data : List Int) : Prop :=\n326:   ∀ m, benchmark_median_low data = some m →\n327:     data.length / 2 + 1 ≤ data.countP (fun x => decide (m ≤ x))\n328: \n329: theorem upper_half_thm (data : List Int) (h : Pre data) :\n330:     upper_half_prop data := by\n331:   intro m hm\n332:   rw [unified_index_thm data h] at hm\n333:   have hpos : 0 < data.length := List.length_pos_of_ne_nil h\n334:   have hlen_eq : (data.mergeSort (· ≤ ·)).length = data.length := List.length_mergeSort data\n335:   have hk : (data.length - 1) / 2 < (data.mergeSort (· ≤ ·)).length := by omega\n336:   rw [List.getElem?_eq_getElem hk, Option.some.injEq] at hm\n337:   subst hm\n338:   have hperm_count : data.countP (fun x => decide ((data.mergeSort (· ≤ ·))[(data.length - 1) / 2] ≤ x)) =\n339:       (data.mergeSort (· ≤ ·)).countP (fun x => decide ((data.mergeSort (· ≤ ·))[(data.length - 1) / 2] ≤ x)) :=\n340:     (List.mergeSort_perm data _).symm.countP_eq _\n341:   rw [hperm_count]\n342:   have hge := countP_ge_of_sorted (pairwise_mergeSort_int data) hk\n343:   omega\n344: \n345: /-- Property 9: The low median is bounded below by the minimum (first sorted element)\n346:     and bounded above by the maximum (last sorted element) of `data`. -/\n347: @[reducible]\n348: def bounds_prop (data : List Int) : Prop :=\n349:   let sorted := data.mergeSort (· ≤ ·)\n350:   ∀ m, benchmark_median_low data = some m →\n351:     (∀ a, sorted[0]? = some a → a ≤ m) ∧\n352:     (∀ b, sorted[data.length - 1]? = some b → m ≤ b)\n353: \n354: theorem bounds_thm (data : List Int) (h : Pre data) :\n355:     bounds_prop data := by\n356:   intro m hm\n357:   rw [unified_index_thm data h] at hm\n358:   have hpos : 0 < data.length := List.length_pos_of_ne_nil h\n359:   have hlen_eq : (data.mergeSort (· ≤ ·)).length = data.length := List.length_mergeSort data\n360:   have hk : (data.length - 1) / 2 < (data.mergeSort (· ≤ ·)).length := by omega\n361:   have h0 : 0 < (data.mergeSort (· ≤ ·)).length := by omega\n362:   have hlast : data.length - 1 < (data.mergeSort (· ≤ ·)).length := by omega\n363:   rw [List.getElem?_eq_getElem hk, Option.some.injEq] at hm\n364:   subst hm\n365:   refine ⟨?_, ?_⟩\n366:   · intro a ha\n367:     rw [List.getElem?_eq_getElem h0, Option.some.injEq] at ha\n368:     subst ha\n369:     exact sorted_getElem_mono (pairwise_mergeSort_int data) h0 hk (by omega)\n370:   · intro b hb\n371:     rw [List.getElem?_eq_getElem hlast, Option.some.injEq] at hb\n372:     subst hb\n373:     exact sorted_getElem_mono (pairwise_mergeSort_int data) hk hlast (by omega)\n374: \n375: /-- Property 10: Sorting the input before calling `benchmark_median_low` leaves the result unchanged. -/\n376: @[reducible]\n377: def sorted_idempotent_prop (data : List Int) : Prop :=\n378:   benchmark_median_low (data.mergeSort (· ≤ ·)) = benchmark_median_low data\n379: \n380: theorem sorted_idempotent_thm (data : List Int) :\n381:     sorted_idempotent_prop data := by\n382:   unfold sorted_idempotent_prop\n383:   rw [benchmark_eq_median_low, benchmark_eq_median_low]\n384:   unfold median_low\n385:   rw [mergeSort_eq_self_of_sorted (pairwise_mergeSort_int data)]\n386: \n387: /-- Property 11: `benchmark_median_low` is invariant under list permutations. -/\n388: @[reducible]\n389: def perm_invariant_prop (data₁ data₂ : List Int) : Prop :=\n390:   data₁.Perm data₂ → benchmark_median_low data₁ = benchmark_median_low data₂\n391: \n392: theorem perm_invariant_thm (data₁ data₂ : List Int) :\n393:     perm_invariant_prop data₁ data₂ := by\n394:   intro hperm\n395:   rw [benchmark_eq_median_low, benchma