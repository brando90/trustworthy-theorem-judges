e : Bool) :\n    (escapeSinglePassImp s quote).data = s.data.flatMap (fun c => escapeChar c quote) := by\n  simp only [escapeSinglePassImp]\n  have h : ∀ (l : List Char) (acc : List Char),\n      Id.run (forIn l acc fun c r =>\n        if (c == '&') = true then pure (ForInStep.yield (r ++ \"&amp;\".data))\n        else if (c == '<') = true then pure (ForInStep.yield (r ++ \"&lt;\".data))\n        else if (c == '>') = true then pure (ForInStep.yield (r ++ \"&gt;\".data))\n        else if (quote && c == '\"') = true then pure (ForInStep.yield (r ++ \"&quot;\".data))\n        else if (quote && c == '\\'') = true then pure (ForInStep.yield (r ++ \"&#x27;\".data))\n        else pure (ForInStep.yield (r ++ [c]))) =\n      acc ++ l.flatMap (fun c => escapeChar c quote) := by\n    intro l\n    induction l with\n    | nil => intro acc; simp\n    | cons c cs ih =>\n      intro acc\n      simp only [List.forIn_cons, List.flatMap_cons]\n      unfold escapeChar\n      split_ifs <;> simp only [Bind.bind, Id.bind, pure, Id.pure, ih, List.append_assoc]\n  simpa using (h s.data [])\nEOF\n","WaitMsBeforeAsync":10000,"toolSummary":"Test simp only [List.forIn_cons] on escapeSinglePassImp_data"}}]}
