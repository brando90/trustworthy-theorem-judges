{"step_index":54,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-16T21:34:57Z","content":"Created At: 2026-11-16T21:34:57Z\nCompleted At: 2026-11-16T21:34:58Z\nCreated At: 2026-11-16T21:34:57Z\nCompleted At: 2026-11-16T21:34:58Z\nShowing lines 1-480 of 480\n1: import Mathlib\n2: \n3: /-!\n4: # Check if a Non-Negative Integer is Prime\n5: \n6: This module translates the Python `is_prime` function into Lean 4, following the\n7: VeriBench specification format.\n8: \n9: Given a non-negative integer `n`, `is_prime n` checks whether `n` is a prime number\n10: (a natural number greater than `1` that is not divisible by any positive integer\n11: other than `1` and itself) using trial division by `2`, `3`, and integers of the\n12: form `6k ± 1` up to `⌊√n⌋`.\n13: -/\n14: \n15: namespace «23_is_prime»\n16: \n17: /-! ## Implementation (Functional) -/\n18: \n19: /--\n20: Helper function that checks whether `n` has any divisor of the form `i` or `i + 2`\n21: (representing `6k - 1` and `6k + 1`) starting from `i` and stepping by `6` up to `limit`.\n22: -/\n23: def checkDivisors (n : Nat) (i : Nat) (limit : Nat) : Bool :=\n24:   if _ : i ≤ limit then\n25:     if n % i == 0 || n % (i + 2) == 0 then\n26:       false\n27:     else\n28:       checkDivisors n (i + 6) limit\n29:   else\n30:     true\n31: termination_by limit + 1 - i\n32: \n33: /--\n34: Check if a non-negative integer is prime.\n35: A prime number is a natural number greater than 1 that is not divisible by any\n36: positive integer other than 1 and itself.\n37: -/\n38: def is_prime (n : Int) : Bool :=\n39:   if n ≤ 1 then\n40:     false\n41:   else if n ≤ 3 then\n42:     true\n43:   else if n % 2 == 0 || n % 3 == 0 then\n44:     false\n45:   else\n46:     let natN := n.toNat\n47:     checkDivisors natN 5 (Nat.sqrt natN)\n48: \n49: /-! ## Unit Tests -/\n50: \n51: -- Docstring examples\n52: example : is_prime 2 = true := by native_decide\n53: example : is_prime 4 = false := by native_decide\n54: example : is_prime 0 = false := by native_decide\n55: \n56: -- Test suite (`check`) examples and additional edge/composite/prime cases\n57: example : is_prime 7 = true := by native_decide\n58: example : is_prime 1 = false := by native_decide\n59: example : is_prime (-1) = false := by native_decide\n60: example : is_prime 3 = true := by native_decide\n61: example : is_prime 5 = true := by native_decide\n62: example : is_prime 9 = false := by native_decide\n63: example : is_prime 25 = false := by native_decide\n64: example : is_prime 29 = true := by native_decide\n65: example : is_prime 35 = false := by native_decide\n66: example : is_prime 49 = false := by native_decide\n67: example : is_prime 97 = true := by native_decide\n68: example : is_prime 121 = false := by native_decide\n69: \n70: #eval is_prime 2\n71: #eval is_prime 4\n72: #eval is_prime 0\n73: #eval is_prime 7\n74: #eval is_prime 97\n75: \n76: /-! ## Pre-condition -/\n77: \n78: /--\n79: Pre-condition for `is_prime`: the input integer `n` must be non-negative (`n ≥ 0`),\n80: corresponding to `def pre(n: int) -> bool: return isinstance(n, int) and n >= 0`.\n81: -/\n82: def Pre (n : Int) : Prop :=\n83:   0 ≤ n\n84: \n85: /-! ## Property Propositions and Theorems -/\n86: \n87: /--\n88: Characterization of `checkDivisors`: it returns `true` if and only if for every step `k`\n89: with `i + 6 * k ≤ limit`, neither `i + 6 * k` nor `i + 6 * k + 2` divides `n`.\n90: -/\n91: theorem checkDivisors_eq_true_iff (n i limit : Nat) :\n92:     checkDivisors n i limit = true ↔\n93:       ∀ k : Nat, i + 6 * k ≤ limit → ¬(i + 6 * k ∣ n) ∧ ¬(i + 6 * k + 2 ∣ n) := by\n94:   induction i using checkDivisors.induct n limit with\n95:   | case1 i hi hdiv =>\n96:     rw [checkDivisors]\n97:     simp only [hi, ↓reduceDIte, hdiv, ↓reduceIte, Bool.false_eq_true, false_iff, not_forall, not_and]\n98:     have hdiv' : n % i = 0 ∨ n % (i + 2) = 0 := by simpa using hdiv\n99:     refine ⟨0, by omega, ?_⟩\n100:     intro h1\n101:     rcases hdiv' with h | h\n102:     · exfalso; exact h1 (by simpa using Nat.dvd_of_mod_eq_zero h)\n103:     · simpa using Nat.dvd_of_mod_eq_zero h\n104:   | case2 i hi hdiv ih =>\n105:     rw [checkDivisors]\n106:     simp only [hi, ↓reduceDIte, hdiv, Bool.false_eq_true, ↓reduceIte]\n107:     rw [ih]\n108:     have hdiv' : ¬(i ∣ n) ∧ ¬(i + 2 ∣ n) := by\n109:       simp [Nat.dvd_iff_mod_eq_zero] at hdiv ⊢\n110:       exact hdiv\n111:     constructor\n112:     · intro hAll k hk\n113:       cases k with\n114:       | zero =>\n115:         simpa using hdiv'\n116:       | succ k' =>\n117:         have hk' : (i + 6) + 6 * k' ≤ limit := by omega\n118:         have hstep := hAll k' hk'\n119:         have heq1 : (i + 6) + 6 * k' = i + 6 * (k' + 1) := by omega\n120:         rw [← heq1]\n121:         exact hstep\n122:     · intro hAll k' hk'\n123:       have hk : i + 6 * (k' + 1) ≤ limit := by omega\n124:       have hstep := hAll (k' + 1) hk\n125:       have heq1 : (i + 6) + 6 * k' = i + 6 * (k' + 1) := by omega\n126:       rw [heq1]\n127:       exact hstep\n128:   | case3 i hi =>\n129:     rw [checkDivisors]\n130:     simp [hi]\n131:     intro k hk\n132:     omega\n133: \n134: /--\n135: Core equivalence theorem: `is_prime n = true` if and only if `0 ≤ n` and `n.toNat` is prime.\n136: -/\n137: theorem is_prime_eq_true_iff_nat_prime (n : Int) :\n138:     is_prime n = true ↔ (0 ≤ n ∧ Nat.Prime n.toNat) := by\n139:   unfold is_prime\n140:   by_cases h1 : n ≤ 1\n141:   · simp [h1]\n142:     intro _ hp\n143:     have : n.toNat ≤ 1 := by omega\n144:     have := hp.two_le\n145:     omega\n146:   · by_cases h3 : n ≤ 3\n147:     · simp only [h1, ↓reduceIte, h3, true_iff]\n148:       refine ⟨by omega, ?_⟩\n149:       have : n.toNat = 2 ∨ n.toNat = 3 := by omega\n150:       rcases this with h | h <;> rw [h]\n151:       · exact Nat.prime_two\n152:       · exact Nat.prime_three\n153:     · simp only [h1, ↓reduceIte, h3]\n154:       by_cases h23 : (n % 2 == 0 || n % 3 == 0) = true\n155:       · simp only [h23, ↓reduceIte, Bool.false_eq_true, false_iff, not_and]\n156:         intro _ hp\n157:         have hdiv : n.toNat % 2 = 0 ∨ n.toNat % 3 = 0 := by\n158:           simp [Bool.or_eq_true, beq_iff_eq] at h23\n159:           omega\n160:         rcases hdiv with h2 | h3'\n161:         · have hdvd : 2 ∣ n.toNat := Nat.dvd_of_mod_eq_zero h2\n162:           rcases (Nat.dvd_prime hp).mp hdvd with h | h <;> omega\n163:         · have hdvd : 3 ∣ n.toNat := Nat.dvd_of_mod_eq_zero h3'\n164:           rcases (Nat.dvd_prime hp).mp hdvd with h | h <;> omega\n165:       · simp only [h23, Bool.false_eq_true, ↓reduceIte]\n166:         rw [checkDivisors_eq_true_iff]\n167:         have hn4 : 4 ≤ n.toNat := by omega\n168:         have hn0 : 0 ≤ n := by omega\n169:         have hnot23 : ¬(2 ∣ n.toNat) ∧ ¬(3 ∣ n.toNat) := by\n170:           simp [Bool.or_eq_true, beq_iff_eq] at h23\n171:           rw [Nat.dvd_iff_mod_eq_zero, Nat.dvd_iff_mod_eq_zero]\n172:           omega\n173:         constructor\n174:         · intro hAll\n175:           refine ⟨hn0, ?_⟩\n176:           by_contra hnp\n177:           have hpos : 0 < n.toNat := by omega\n178:           have hne1 : n.toNat ≠ 1 := by omega\n179:           have hp_prime : Nat.Prime n.toNat.minFac := Nat.minFac_prime hne1\n180:           have hp_dvd : n.toNat.minFac ∣ n.toNat := Nat.minFac_dvd n.toNat\n181:           have hp_sq : n.toNat.minFac ^ 2 ≤ n.toNat := Nat.minFac_sq_le_self hpos hnp\n182:           have hp_le_sqrt : n.toNat.minFac ≤ Nat.sqrt n.toNat := by\n183:             rw [Nat.le_sqrt]\n184:             simpa [sq] using hp_sq\n185:           have hp2 : 2 ≤ n.toNat.minFac := hp_prime.two_le\n186:           have hp_not2 : ¬(2 ∣ n.toNat.minFac) := fun hd => hnot23.1 (dvd_trans hd hp_dvd)\n187:           have hp_not3 : ¬(3 ∣ n.toNat.minFac) := fun hd => hnot23.2 (dvd_trans hd hp_dvd)\n188:           have hp5 : 5 ≤ n.toNat.minFac := by omega\n189:           let k := (n.toNat.minFac - 5) / 6\n190:           have hm2 : (n.toNat.minFac - 5) % 2 = 0 := by omega\n191:           have hm3 : (n.toNat.minFac - 5) % 3 ≠ 1 := by omega\n192:           have hform : n.toNat.minFac = 5 + 6 * k ∨ n.toNat.minFac = 5 + 6 * k + 2 := by omega\n193:           have hk_le : 5 + 6 * k ≤ Nat.sqrt n.toNat := by omega\n194:           have hstep := hAll k hk_le\n195:           rcases hform with h5 | h7\n196:           · rw [← h5] at hstep\n197:             exact hstep.1 hp_dvd\n198:           · rw [← h7] at hstep\n199:             exact hstep.2 hp_dvd\n200:         · rintro ⟨_, hp⟩ k hk\n201:           have hsq : (5 + 6 * k) * (5 + 6 * k) ≤ n.toNat := Nat.le_sqrt.mp hk\n202:           constructor\n203:           · intro hdvd\n204:             rcases (Nat.dvd_prime hp).mp hdvd with h | h <;> nlinarith\n205:           · intro hdvd\n206:             rcases (Nat.dvd_prime hp).mp hdvd with h | h <;> nlinarith\n207: \n208: /--\n209: Property 1: Numbers less than or equal to `1` (including `0` and `1`) are not prime.\n210: -/\n211: def le_one_not_prime_prop (n : Int) : Prop :=\n212:   n ≤ 1 → is_prime n = false\n213: \n214: /-- Theorem proving `le_one_not_prime_prop` under `Pre`. -/\n215: theorem le_one_not_prime_thm (n : Int) : Pre n → le_one_not_prime_prop n := by\n216:   intro _ h1\n217:   unfold is_prime\n218:   simp [h1]\n219: \n220: /--\n221: Property 2: The small integers `2` and `3` are prime.\n222: -/\n223: def small_primes_prop (n : Int) : Prop :=\n224:   (n = 2 ∨ n = 3) → is_prime n = true\n225: \n226: /-- Theorem proving `small_primes_prop` under `Pre`. -/\n227: theorem small_primes_thm (n : Int) : Pre n → small_primes_prop n := by\n228:   intro _ h23\n229:   unfold is_prime\n230:   rcases h23 with rfl | rfl <;> simp\n231: \n232: /--\n233: Property 3: Any integer greater than `3` that is divisible by `2` or `3` is not prime.\n234: -/\n235: def div_two_or_three_not_prime_prop (n : Int) : Prop :=\n236:   n > 3 → (n % 2 = 0 ∨ n % 3 = 0) → is_prime n = false\n237: \n238: /-- Theorem proving `div_two_or_three_not_prime_prop` under `Pre`. -/\n239: theorem div_two_or_three_not_prime_thm (n : Int) : Pre n → div_two_or_three_not_prime_prop n := by\n240:   intro _ hgt3 hdiv\n241:   unfold is_prime\n242:   have hnot1 : ¬(n ≤ 1) := by omega\n243:   have hnot3 : ¬(n ≤ 3) := by omega\n244:   have hcond : (n % 2 == 0 || n % 3 == 0) = true := by\n245:     simp only [Bool.or_eq_true, beq_iff_eq]\n246:     exact hdiv\n247:   simp [hnot1, hnot3, hcond]\n248: \n249: /--\n250: Property 4: Docstring primality specification — `is_prime n = true` if and only if\n251: `n > 1` and `n` is not divisible by any integer `d` with `1 < d < n`.\n252: -/\n253: def prime_divisibility_prop (n : Int) : Prop :=\n254:   is_prime n = true ↔ (1 < n ∧ ∀ d : Int, 1 < d → d < n → ¬(d ∣ n))\n255: \n256: /-- Theorem proving `prime_divisibility_prop` under `Pre`. -/\n257: theorem prime_divisibility_thm (n : Int) : Pre n → prime_divisibility_prop n := by\n258:   intro _\n259:   unfold prime_divisibility_prop\n260:   rw [is_prime_eq_true_iff_nat_prime, Nat.prime_def_lt']\n261:   constructor\n262:   · rintro ⟨hn0, hn2, hdiv⟩\n263:     refine ⟨by omega, ?_⟩\n264:     intro d hd1 hdn hdvd\n265:     have hd_nonneg : 0 ≤ d := by omega\n266:     have hd_nat : (d.toNat : Int) = d := Int.toNat_of_nonneg hd_nonneg\n267:     have hn_nat : (n.toNat : Int) = n := Int.toNat_of_nonneg hn0\n268:     have hdvd_nat : d.toNat ∣ n.toNat := by\n269:       rw [← Int.ofNat_dvd, hd_nat, hn_nat]\n270:       exact hdvd\n271:     exact hdiv d.toNat (by omega) (by omega) hdvd_nat\n272:   · rintro ⟨hn1, hdiv⟩\n273:     have hn0 : 0 ≤ n := by omega\n274:     refine ⟨hn0, by omega, ?_⟩\n275:     intro m hm2 hmn hdvd\n276:     have hdvd_int : (m : Int) ∣ n := by\n277:       have hn_nat : (n.toNat : Int) = n := Int.toNat_of_nonneg hn0\n278:       rw [← hn_nat]\n279:       exact Int.ofNat_dvd.mpr hdvd\n280:     exact hdiv (m : Int) (by omega) (by omega) hdvd_int\n281: \n282: /--\n283: Property 5: Equivalence with Mathlib's `Nat.Prime` predicate on `n.toNat`.\n284: -/\n285: def nat_prime_iff_prop (n : Int) : Prop :=\n286:   is_prime n = true ↔ (0 ≤ n ∧ Nat.Prime n.toNat)\n287: \n288: /-- Theorem proving `nat_prime_iff_prop` under `Pre`. -/\n289: theorem nat_prime_iff_thm (n : Int) : Pre n → nat_prime_iff_prop n := by\n290:   intro _\n291:   exact is_prime_eq_true_iff_nat_prime n\n292: \n293: /-! ## Post-condition -/\n294: \n295: /--\n296: Full post-condition for `is_prime` as the conjunction of all stated properties.\n297: -/\n298: def Post_prop (n : Int) : Prop :=\n299:   le_one_not_prime_prop n ∧\n300:   small_primes_prop n ∧\n301:   div_two_or_three_not_prime_prop n ∧\n302:   prime_divisibility_prop n ∧\n303:   nat_prime_iff_prop n\n304: \n305: /-! ## Property-Based Tests (PBTs) -/\n306: \n307: -- Randomized PBTs for each property and the post-condition\n308: #eval Plausible.Testable.check (∀ n : Int, 0 ≤ n →\n309:   (!decide (n ≤ 1) || is_prime n == false) = true) { numRetries := 50 }\n310: \n311: #eval Plausible.Testable.check (∀ n : Int, 0 ≤ n →\n312:   (!decide (n = 2 ∨ n = 3) || is_prime n == true) = true) { numRetries := 50 }\n313: \n314: #eval Plausible.Testable.check (∀ n : Int, 0 ≤ n →\n315:   (!decide (n > 3 ∧ (n % 2 = 0 ∨ n % 3 = 0)) || is_prime n == false) = true) { numRetries := 50 }\n316: \n317: #eval Plausible.Testable.check (∀ n : Int, 0 ≤ n →\n318:   (is_prime n == decide (1 < n ∧ ((List.range n.toNat).filter (· ≥ 2)).all (fun d => !(d ∣ n.toNat)))) = true) { numRetries := 50 }\n319: \n320: #eval Plausible.Testable.check (∀ n : Int, 0 ≤ n →\n321:   (is_prime n == decide (0 ≤ n ∧ Nat.Prime n.toNat)) = true) { numRetries := 50 }\n322: \n323: #eval Plausible.Testable.check (∀ n : Int, 0 ≤ n →\n324:   ((!decide (n ≤ 1) || is_prime n == false) &&\n325:    (!decide (n = 2 ∨ n = 3) || is_prime n == true) &&\n326:    (!decide (n > 3 ∧ (n % 2 = 0 ∨ n % 3 = 0)) || is_prime n == false) &&\n327:    (is_prime n == decide (1 < n ∧ ((List.range n.toNat).filter (· ≥ 2)).all (fun d => !(d ∣ n.toNat)))) &&\n328:    (is_prime n == decide (0 ≤ n ∧ Nat.Prime n.toNat))) = true) { numRetries := 50 }\n329: \n330: -- Bounded exhaustive PBTs over [0, 200) for each property and the post-condition\n331: example : (List.range 200).all (fun m =>\n332:   let n : Int := m\n333:   (!decide (n ≤ 1) || is_prime n == false)) = true := by native_decide\n334: \n335: example : (List.range 200).all (fun m =>\n336:   let n : Int := m\n337:   (!decide (n = 2 ∨ n = 3) || is_prime n == true)) = true := by native_decide\n338: \n339: example : (List.range 200).all (fun m =>\n340:   let n : Int := m\n341:   (!decide (n > 3 ∧ (n % 2 = 0 ∨ n % 3 = 0)) || is_prime n == false)) = true := by native_decide\n342: \n343: example : (List.range 200).all (fun m =>\n344:   let n : Int := m\n345:   is_prime n == decide (1 < n ∧ ((List.range n.toNat).filter (· ≥ 2)).all (fun d => !(d ∣ n.toNat)))) = true := by native_decide\n346: \n347: example : (List.range 200).all (fun m =>\n348:   let n : Int := m\n349:   is_prime n == decide (0 ≤ n ∧ Nat.Prime n.toNat)) = true := by native_decide\n350: \n351: example : (List.range 200).all (fun m =>\n352:   let n : Int := m\n353:   (!decide (n ≤ 1) || is_prime n == false) &&\n354:   (!decide (n = 2 ∨ n = 3) || is_prime n == true) &&\n355:   (!decide (n > 3 ∧ (n % 2 = 0 ∨ n % 3 = 0)) || is_prime n == false) &&\n356:   (is_prime n == decide (1 < n ∧ ((List.range n.toNat).filter (· ≥ 2)).all (fun d => !(d ∣ n.toNat)))) &&\n357:   (is_prime n == decide (0 ≤ n ∧ Nat.Prime n.toNat))) = true := by native_decide\n358: \n359: /-! ## Correctness Theorem (Pre -> Post) -/\n360: \n361: /--\n362: Main correctness theorem: for any integer `n` satisfying `Pre n`, `Post_prop n` holds.\n363: -/\n364: theorem is_prime_correct (n : Int) : Pre n → Post_prop n := by\n365:   intro hpre\n366:   exact ⟨le_one_not_prime_thm n hpre,\n367:          small_primes_thm n hpre,\n368:          div_two_or_three_not_prime_thm n hpre,\n369:          prime_divisibility_thm n hpre,\n370:          nat_prime_iff_thm n hpre⟩\n371: \n372: /-! ## Imperative Implementation -/\n373: \n374: /--\n375: Imperative implementation of `is_prime` using `Id.run do` and mutable loop state,\n376: following the Python `for i in range(5, int(math.sqrt(n)) + 1, 6)` loop.\n377: -/\n378: def is_prime_imp (n : Int) : Bool := Id.run do\n379:   if n ≤ 1 then\n380:     return false\n381:   if n ≤ 3 then\n382:     return true\n383:   if n % 2 == 0 || n % 3 == 0 then\n384:     return false\n385:   let natN := n.toNat\n386:   let limit := Nat.sqrt natN\n387:   let mut i := 5\n388:   let mut isPrime := true\n389:   for _ in List.range (limit + 1) do\n390:     if i ≤ limit then\n391:       if natN % i == 0 || natN % (i + 2) == 0 then\n392:         isPrime := false\n393:         break\n394:       i := i + 6\n395:   return isPrime\n396: \n397: /-! ## Imperative Tests -/\n398: \n399: example : is_prime_imp 2 = true := by native_decide\n400: example : is_prime_imp 4 = false := by native_decide\n401: example : is_prime_imp 0 = false := by native_decide\n402: example : is_prime_imp 7 = true := by native_decide\n403: example : is_prime_imp 1 = false := by native_decide\n404: example : is_prime_imp (-1) = false := by native_decide\n405: example : is_prime_imp 3 = true := by native_decide\n406: example : is_prime_imp 5 = true := by native_decide\n407: example : is_prime_imp 9 = false := by native_decide\n408: example : is_prime_imp 25 = false := by native_decide\n409: example : is_prime_imp 29 = true := by native_decide\n410: example : is_prime_imp 35 = false := by native_decide\n411: example : is_prime_imp 49 = false := by native_decide\n412: example : is_prime_imp 97 = true := by native_decide\n413: example : is_prime_imp 121 = false := by native_decide\n414: \n415: #eval is_prime_imp 2\n416: #eval is_prime_imp 4\n417: #eval is_prime_imp 0\n418: #eval is_prime_imp 7\n419: #eval is_prime_imp 97\n420: \n421: /-! ## Equivalence Theorem (Functional = Imperative) -/\n422: \n423: /--\n424: Helper lemma proving that the imperative `for` loop in `is_prime_imp` computes the\n425: same result as the recursive `checkDivisors` function whenever `limit + 1 - i ≤ xs.length`.\n426: -/\n427: theorem loop_eq_checkDivisors (natN limit : Nat) (xs : List Nat) (i : Nat)\n428:     (h : limit + 1 - i ≤ xs.length) :\n429:     (Id.run do\n430:       let mut i := i\n431:       let mut isPrime := true\n432:       for _ in xs do\n433:         if i ≤ limit then\n434:           if natN % i == 0 || natN % (i + 2) == 0 then\n435:             isPrime := false\n436:             break\n437:           i := i + 6\n438:       return isPrime) = checkDivisors natN i limit := by\n439:   induction xs generalizing i with\n440:   | nil =>\n441:     simp at h\n442:     unfold checkDivisors\n443:     have : ¬ (i ≤ limit) := by omega\n444:     simp [this]\n445:   | cons x xs ih =>\n446:     by_cases hi : i ≤ limit\n447:     · by_cases hdiv : natN % i = 0 ∨ natN % (i + 2) = 0\n448:       · rw [checkDivisors]\n449:         simp [hi, hdiv]\n450:       · have hlen : limit + 1 - (i + 6) ≤ xs.length := by\n451:           simp at h\n452:           omega\n453:         have ih' := ih (i + 6) hlen\n454:         rw [checkDivisors]\n455:         simp [hi, hdiv] at ih' ⊢\n456:         exact ih'\n457:     · have ih' := ih i (by omega)\n458:       simp [hi] at ih' ⊢\n459:       exact ih'\n460: \n461: /--\n462: Equivalence theorem showing that the functional implementation `is_prime` and the\n463: imperative implementation `is_prime_imp` agree on all integer inputs `n`.\n464: -/\n465: theorem is_prime_eq_is_prime_imp (n : Int) : is_prime n = is_prime_imp n := by\n466:   unfold is_prime is_prime_imp\n467:   by_cases h1 : n ≤ 1\n468:   · simp [h1]\n469:   · by_cases h3 : n ≤ 3\n470:     · simp [h1, h3]\n471:     · by_cases h2 : 2 ∣ n\n472:       · simp [h1, h3, h2]\n473:       · by_cases h3' : 3 ∣ n\n474:         · simp [h1, h3, h2, h3']\n475:         · have hloop := loop_eq_checkDivisors n.toNat (Nat.sqrt n.toNat)\n476:             (List.range 