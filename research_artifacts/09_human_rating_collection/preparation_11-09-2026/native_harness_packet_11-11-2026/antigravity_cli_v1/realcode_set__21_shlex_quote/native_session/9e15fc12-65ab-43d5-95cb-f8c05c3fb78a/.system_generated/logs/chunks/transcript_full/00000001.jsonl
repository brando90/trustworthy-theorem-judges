{"step_index":85,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-16T22:30:43Z","content":"Created At: 2026-11-16T22:30:43Z\nCompleted At: 2026-11-16T22:30:43Z\nCreated At: 2026-11-16T22:30:43Z\nCompleted At: 2026-11-16T22:30:43Z\nShowing lines 1-550 of 550\n1: import Mathlib\n2: \n3: /-!\n4: # Shell-Escaping a String (`shlex.quote`)\n5: \n6: Formalization of Python's `shlex.quote` function from the standard `shlex` library.\n7: Given an input string `s`, `quote` returns a shell-escaped version suitable for POSIX shells:\n8: 1. If `s` is empty (`\"\"`), it returns `\"''\"`.\n9: 2. If `s` is non-empty and every character in `s` belongs to the POSIX safe character set\n10:    (`a`..`z`, `A`..`Z`, `0`..`9`, and `_`, `@`, `%`, `+`, `=`, `:`, `,`, `.`, `/`, `-`),\n11:    it returns `s` unchanged.\n12: 3. Otherwise, it encloses `s` in single quotes `'...'` and replaces each single quote `'`\n13:    inside `s` with the 5-character sequence `\"'\\\"'\\\"'\"`.\n14: -/\n15: \n16: namespace «21_shlex_quote»\n17: \n18: /-! ## 4. Implementation (Functional Definition) -/\n19: \n20: /-- The list of safe characters for POSIX shells that do not require escaping. -/\n21: def safeChars : List Char :=\n22:   \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_@%+=:,./-\".toList\n23: \n24: /-- Returns `true` iff `c` is a safe character for POSIX shells. -/\n25: def isSafeChar (c : Char) : Bool :=\n26:   decide (c ∈ safeChars)\n27: \n28: /-- Escapes a single character for use inside a single-quoted POSIX shell string:\n29:     `'` becomes `\"'\\\"'\\\"'\"`, and every other character remains `[c]`. -/\n30: def escapeChar (c : Char) : List Char :=\n31:   if c == '\\'' then \"'\\\"'\\\"'\".toList else [c]\n32: \n33: /-- Replaces every single quote `'` in `s` with `\"'\\\"'\\\"'\"`. -/\n34: def replaceSingleQuotes (s : String) : String :=\n35:   String.mk (s.toList.flatMap escapeChar)\n36: \n37: /-- Inverse of `escapeChar` over character lists: converts each `\"'\\\"'\\\"'\"` sequence back to `'\\''`. -/\n38: def unescapeChars : List Char → List Char\n39:   | [] => []\n40:   | c :: rest =>\n41:     if c == '\\'' then\n42:       match rest with\n43:       | _ :: _ :: _ :: _ :: tail => '\\'' :: unescapeChars tail\n44:       | _ => ['\\'']\n45:     else\n46:       c :: unescapeChars rest\n47: \n48: /-- Inverse of `quote` on character lists. -/\n49: def unquoteChars : List Char → List Char\n50:   | [] => []\n51:   | c :: cs => if c == '\\'' then unescapeChars cs.dropLast else c :: cs\n52: \n53: /-- Unquotes a shell-escaped string produced by `quote`. -/\n54: def unquote (q : String) : String :=\n55:   String.mk (unquoteChars q.toList)\n56: \n57: /-- Functional implementation of Python's `shlex.quote`. -/\n58: def quote (s : String) : String :=\n59:   if s = \"\" then\n60:     \"''\"\n61:   else if s.toList.all isSafeChar then\n62:     s\n63:   else\n64:     \"'\" ++ replaceSingleQuotes s ++ \"'\"\n65: \n66: /-- Main function to be verified, corresponding to Python's `benchmark_quote`. -/\n67: def benchmark_quote (s : String) : String :=\n68:   quote s\n69: \n70: /-! ## 5. Unit Tests -/\n71: \n72: -- 1. Test empty string\n73: example : quote \"\" = \"''\" := by native_decide\n74: -- 2. Test safe string\n75: example : quote \"abc\" = \"abc\" := by native_decide\n76: -- 3. Test string with spaces\n77: example : quote \"a b c\" = \"'a b c'\" := by native_decide\n78: -- 4. Test string with quotes\n79: example : quote \"a'b\" = \"'a'\\\"'\\\"'b'\" := by native_decide\n80: -- 5. Additional tests on punctuation and benchmark_quote\n81: example : quote \"path/to/file_1.txt\" = \"path/to/file_1.txt\" := by native_decide\n82: example : quote \"'\" = \"''\\\"'\\\"''\" := by native_decide\n83: example : benchmark_quote \"a'b\" = \"'a'\\\"'\\\"'b'\" := by native_decide\n84: \n85: #eval quote \"\"\n86: #eval quote \"abc\"\n87: #eval quote \"a b c\"\n88: #eval quote \"a'b\"\n89: #eval benchmark_quote \"a'b\"\n90: \n91: /-! ## 6. Pre-condition Predicate -/\n92: \n93: /-- Pre-condition for `quote`: in Lean 4, the input `s : String` is statically guaranteed\n94:     to be a string (`isinstance(s, str)`). -/\n95: def Pre (_s : String) : Prop :=\n96:   True\n97: \n98: /-- Alias matching the Python `pre_quote` name. -/\n99: abbrev pre_quote (s : String) : Prop :=\n100:   Pre s\n101: \n102: instance (s : String) : Decidable (Pre s) :=\n103:   isTrue trivial\n104: \n105: /-! ## Helper Lemmas for Properties -/\n106: \n107: theorem toList_mk (cs : List Char) : (String.mk cs).toList = cs := rfl\n108: \n109: theorem length_mk (cs : List Char) : (String.mk cs).length = cs.length := rfl\n110: \n111: theorem toList_append (s₁ s₂ : String) : (s₁ ++ s₂).toList = s₁.toList ++ s₂.toList := rfl\n112: \n113: theorem length_append (s₁ s₂ : String) : (s₁ ++ s₂).length = s₁.length + s₂.length :=\n114:   String.length_append s₁ s₂\n115: \n116: theorem escapeChar_length (c : Char) :\n117:     (escapeChar c).length = 1 + (if c == '\\'' then 4 else 0) := by\n118:   unfold escapeChar\n119:   split <;> rfl\n120: \n121: theorem flatMap_escapeChar_length (cs : List Char) :\n122:     (cs.flatMap escapeChar).length = cs.length + 4 * cs.count '\\'' := by\n123:   induction cs with\n124:   | nil => rfl\n125:   | cons c cs ih =>\n126:     simp only [List.flatMap_cons, List.length_append, ih, List.length_cons, List.count_cons,\n127:       escapeChar_length, beq_iff_eq]\n128:     split <;> omega\n129: \n130: theorem replaceSingleQuotes_length (s : String) :\n131:     (replaceSingleQuotes s).length = s.length + 4 * s.toList.count '\\'' :=\n132:   flatMap_escapeChar_length s.toList\n133: \n134: theorem flatMap_escapeChar_eq_self {cs : List Char} (h : '\\'' ∉ cs) :\n135:     cs.flatMap escapeChar = cs := by\n136:   induction cs with\n137:   | nil => rfl\n138:   | cons c cs ih =>\n139:     have hc : c ≠ '\\'' := fun heq => h (heq ▸ List.mem_cons_self)\n140:     have hcs : '\\'' ∉ cs := fun hm => h (List.mem_cons_of_mem c hm)\n141:     simp [List.flatMap_cons, escapeChar, hc, ih hcs]\n142: \n143: theorem replaceSingleQuotes_eq_self {s : String} (h : '\\'' ∉ s.toList) :\n144:     replaceSingleQuotes s = s := by\n145:   cases s with\n146:   | mk cs =>\n147:     simp only [replaceSingleQuotes, toList_mk]\n148:     congr 1\n149:     exact flatMap_escapeChar_eq_self h\n150: \n151: theorem isSafeChar_single_quote : isSafeChar '\\'' = false := by\n152:   decide\n153: \n154: theorem all_isSafeChar_false_of_single_quote_mem {s : String} (h : '\\'' ∈ s.toList) :\n155:     s.toList.all isSafeChar = false := by\n156:   rw [List.all_eq_false]\n157:   exact ⟨'\\'', h, by simp [isSafeChar_single_quote]⟩\n158: \n159: theorem empty_all_isSafeChar : (\"\" : String).toList.all isSafeChar = true :=\n160:   rfl\n161: \n162: theorem unsafe_nonempty {s : String} (h : s.toList.all isSafeChar = false) : s ≠ \"\" := by\n163:   intro hs\n164:   subst hs\n165:   revert h\n166:   decide\n167: \n168: theorem quoted_length (s : String) :\n169:     (\"'\" ++ replaceSingleQuotes s ++ \"'\").length = s.length + 2 + 4 * s.toList.count '\\'' := by\n170:   have h1 : (\"'\" : String).length = 1 := rfl\n171:   rw [length_append, length_append, h1, replaceSingleQuotes_length]\n172:   omega\n173: \n174: theorem getLast?_append_singleton (xs : List Char) (c : Char) :\n175:     (xs ++ [c]).getLast? = some c := by\n176:   simp\n177: \n178: theorem unescapeChars_flatMap_escapeChar (cs : List Char) :\n179:     unescapeChars (cs.flatMap escapeChar) = cs := by\n180:   induction cs with\n181:   | nil => rfl\n182:   | cons c cs ih =>\n183:     by_cases hc : c = '\\''\n184:     · subst hc\n185:       change '\\'' :: unescapeChars (cs.flatMap escapeChar) = '\\'' :: cs\n186:       rw [ih]\n187:     · have hbeq : (c == '\\'') = false := beq_false_of_ne hc\n188:       simp only [List.flatMap_cons, escapeChar, hbeq, Bool.false_eq_true, ↓reduceIte,\n189:         List.singleton_append]\n190:       unfold unescapeChars\n191:       simp [hbeq, ih]\n192: \n193: theorem dropLast_append_singleton (xs : List Char) (c : Char) :\n194:     (xs ++ [c]).dropLast = xs := by\n195:   simp\n196: \n197: /-! ## 7. Property Propositions and Theorems -/\n198: \n199: /-- Property 1: An empty input string is escaped as `\"''\"`. -/\n200: def empty_string_prop (s : String) : Prop :=\n201:   s = \"\" → quote s = \"''\"\n202: \n203: instance (s : String) : Decidable (empty_string_prop s) := by\n204:   unfold empty_string_prop; infer_instance\n205: \n206: theorem empty_string_thm (s : String) : empty_string_prop s := by\n207:   intro hs\n208:   simp [quote, hs]\n209: \n210: /-- Property 2: Any non-empty string consisting exclusively of safe characters is returned unchanged. -/\n211: def safe_nonempty_prop (s : String) : Prop :=\n212:   s ≠ \"\" → s.toList.all isSafeChar = true → quote s = s\n213: \n214: instance (s : String) : Decidable (safe_nonempty_prop s) := by\n215:   unfold safe_nonempty_prop; infer_instance\n216: \n217: theorem safe_nonempty_thm (s : String) : safe_nonempty_prop s := by\n218:   intro hne hsafe\n219:   simp only [quote, hne, hsafe, ↓reduceIte]\n220: \n221: /-- Property 3: Any string containing at least one unsafe character is enclosed in single quotes\n222:     with internal single quotes replaced by `\"'\\\"'\\\"'\"`. -/\n223: def unsafe_string_prop (s : String) : Prop :=\n224:   s.toList.all isSafeChar = false → quote s = \"'\" ++ replaceSingleQuotes s ++ \"'\"\n225: \n226: instance (s : String) : Decidable (unsafe_string_prop s) := by\n227:   unfold unsafe_string_prop; infer_instance\n228: \n229: theorem unsafe_string_thm (s : String) : unsafe_string_prop s := by\n230:   intro hunsafe\n231:   have hne : s ≠ \"\" := unsafe_nonempty hunsafe\n232:   simp only [quote, hne, hunsafe, Bool.false_eq_true, ↓reduceIte]\n233: \n234: /-- Property 4: Any string with at least one unsafe character and no single quotes is simply\n235:     wrapped in single quotes `\"'\" ++ s ++ \"'\"`. -/\n236: def unsafe_no_single_quote_prop (s : String) : Prop :=\n237:   s.toList.all isSafeChar = false → '\\'' ∉ s.toList → quote s = \"'\" ++ s ++ \"'\"\n238: \n239: instance (s : String) : Decidable (unsafe_no_single_quote_prop s) := by\n240:   unfold unsafe_no_single_quote_prop; infer_instance\n241: \n242: theorem unsafe_no_single_quote_thm (s : String) : unsafe_no_single_quote_prop s := by\n243:   intro hunsafe hnoq\n244:   rw [unsafe_string_thm s hunsafe, replaceSingleQuotes_eq_self hnoq]\n245: \n246: /-- Property 5: Any string containing a single quote `'` is treated as unsafe and escaped. -/\n247: def single_quote_escaped_prop (s : String) : Prop :=\n248:   '\\'' ∈ s.toList → quote s = \"'\" ++ replaceSingleQuotes s ++ \"'\"\n249: \n250: instance (s : String) : Decidable (single_quote_escaped_prop s) := by\n251:   unfold single_quote_escaped_prop; infer_instance\n252: \n253: theorem single_quote_escaped_thm (s : String) : single_quote_escaped_prop s := by\n254:   intro hmem\n255:   exact unsafe_string_thm s (all_isSafeChar_false_of_single_quote_mem hmem)\n256: \n257: /-- Property 6: The output of `quote` is never empty. -/\n258: def nonempty_output_prop (s : String) : Prop :=\n259:   quote s ≠ \"\" ∧ 0 < (quote s).length\n260: \n261: instance (s : String) : Decidable (nonempty_output_prop s) := by\n262:   unfold nonempty_output_prop; infer_instance\n263: \n264: theorem nonempty_output_thm (s : String) : nonempty_output_prop s := by\n265:   unfold nonempty_output_prop quote\n266:   split\n267:   · decide\n268:   · next hne =>\n269:     split\n270:     · refine ⟨hne, ?_⟩\n271:       cases s with\n272:       | mk cs =>\n273:         cases cs with\n274:         | nil => contradiction\n275:         | cons c cs =>\n276:           change 0 < (c :: cs).length\n277:           simp\n278:     · have hlen := quoted_length s\n279:       refine ⟨?_, by omega⟩\n280:       intro heq\n281:       have h0 : (\"'\" ++ replaceSingleQuotes s ++ \"'\").length = 0 := by\n282:         rw [heq]; rfl\n283:       omega\n284: \n285: /-- Property 7: Shell-escaping never decreases the length of the string. -/\n286: def length_ge_input_prop (s : String) : Prop :=\n287:   s.length ≤ (quote s).length\n288: \n289: instance (s : String) : Decidable (length_ge_input_prop s) := by\n290:   unfold length_ge_input_prop; infer_instance\n291: \n292: theorem length_ge_input_thm (s : String) : length_ge_input_prop s := by\n293:   unfold length_ge_input_prop quote\n294:   split\n295:   · next hs =>\n296:     subst hs\n297:     decide\n298:   · split\n299:     · exact Nat.le_refl _\n300:     · have hlen := quoted_length s\n301:       omega\n302: \n303: /-- Property 8: Whenever `s` is empty or contains an unsafe character, `quote s` has length at least 2\n304:     and starts and ends with `'\\''`. -/\n305: def unsafe_or_empty_enclosing_quotes_prop (s : String) : Prop :=\n306:   (s = \"\" ∨ s.toList.all isSafeChar = false) →\n307:     2 ≤ (quote s).length ∧\n308:     (quote s).toList.head? = some '\\'' ∧\n309:     (quote s).toList.getLast? = some '\\''\n310: \n311: instance (s : String) : Decidable (unsafe_or_empty_enclosing_quotes_prop s) := by\n312:   unfold unsafe_or_empty_enclosing_quotes_prop; infer_instance\n313: \n314: theorem unsafe_or_empty_enclosing_quotes_thm (s : String) :\n315:     unsafe_or_empty_enclosing_quotes_prop s := by\n316:   intro h\n317:   rcases h with rfl | hunsafe\n318:   · decide\n319:   · rw [unsafe_string_thm s hunsafe]\n320:     have hlen := quoted_length s\n321:     refine ⟨by omega, ?_, ?_⟩\n322:     · rfl\n323:     · change (('\\'' :: (replaceSingleQuotes s).toList) ++ ['\\'']).getLast? = some '\\''\n324:       exact getLast?_append_singleton _ '\\''\n325: \n326: /-- Property 9: Exact length formula for strings containing at least one unsafe character. -/\n327: def unsafe_length_exact_prop (s : String) : Prop :=\n328:   s.toList.all isSafeChar = false →\n329:     (quote s).length = s.length + 2 + 4 * s.toList.count '\\''\n330: \n331: instance (s : String) : Decidable (unsafe_length_exact_prop s) := by\n332:   unfold unsafe_length_exact_prop; infer_instance\n333: \n334: theorem unsafe_length_exact_thm (s : String) : unsafe_length_exact_prop s := by\n335:   intro hunsafe\n336:   rw [unsafe_string_thm s hunsafe, quoted_length]\n337: \n338: /-- Property 10: `quote` is idempotent on non-empty safe strings. -/\n339: def safe_idempotent_prop (s : String) : Prop :=\n340:   s ≠ \"\" → s.toList.all isSafeChar = true → quote (quote s) = quote s\n341: \n342: instance (s : String) : Decidable (safe_idempotent_prop s) := by\n343:   unfold safe_idempotent_prop; infer_instance\n344: \n345: theorem safe_idempotent_thm (s : String) : safe_idempotent_prop s := by\n346:   intro hne hsafe\n347:   rw [safe_nonempty_thm s hne hsafe, safe_nonempty_thm s hne hsafe]\n348: \n349: /-- Property 11: Exact characterization of fixed points: `quote s = s` iff `s` is non-empty and all-safe. -/\n350: def unchanged_iff_safe_nonempty_prop (s : String) : Prop :=\n351:   quote s = s ↔ (s ≠ \"\" ∧ s.toList.all isSafeChar = true)\n352: \n353: instance (s : String) : Decidable (unchanged_iff_safe_nonempty_prop s) := by\n354:   unfold unchanged_iff_safe_nonempty_prop; infer_instance\n355: \n356: theorem unchanged_iff_safe_nonempty_thm (s : String) : unchanged_iff_safe_nonempty_prop s := by\n357:   unfold unchanged_iff_safe_nonempty_prop\n358:   constructor\n359:   · intro heq\n360:     by_cases hs : s = \"\"\n361:     · subst hs\n362:       revert heq\n363:       decide\n364:     · by_cases hsafe : s.toList.all isSafeChar = true\n365:       · exact ⟨hs, hsafe⟩\n366:       · have hfalse : s.toList.all isSafeChar = false :=\n367:           Bool.eq_false_iff.mpr hsafe\n368:         have hlen : (quote s).length = s.length + 2 + 4 * s.toList.count '\\'' :=\n369:           unsafe_length_exact_thm s hfalse\n370:         rw [heq] at hlen\n371:         omega\n372:   · rintro ⟨hs, hsafe⟩\n373:     exact safe_nonempty_thm s hs hsafe\n374: \n375: /-- Property 12: Round-trip (lossless escaping) property: `unquote (quote s) = s` for every string `s`. -/\n376: def unquote_quote_prop (s : String) : Prop :=\n377:   unquote (quote s) = s\n378: \n379: instance (s : String) : Decidable (unquote_quote_prop s) := by\n380:   unfold unquote_quote_prop; infer_instance\n381: \n382: theorem unquote_quote_thm (s : String) : unquote_quote_prop s := by\n383:   unfold unquote_quote_prop\n384:   by_cases hs : s = \"\"\n385:   · subst hs\n386:     rfl\n387:   · by_cases hsafe : s.toList.all isSafeChar = true\n388:     · rw [safe_nonempty_thm s hs hsafe]\n389:       cases s with\n390:       | mk cs =>\n391:         cases cs with\n392:         | nil => contradiction\n393:         | cons c cs =>\n394:           have hcsafe : isSafeChar c = true := by\n395:             simp only [toList_mk, List.all_cons, Bool.and_eq_true] at hsafe\n396:             exact hsafe.1\n397:           have hcne : c ≠ '\\'' := by\n398:             intro heq\n399:             subst heq\n400:             revert hcsafe\n401:             decide\n402:           have hbeq : (c == '\\'') = false := beq_false_of_ne hcne\n403:           simp [unquote, unquoteChars, hbeq]\n404:     · have hfalse : s.toList.all isSafeChar = false := Bool.eq_false_iff.mpr hsafe\n405:       rw [unsafe_string_thm s hfalse]\n406:       cases s with\n407:       | mk cs =>\n408:         unfold unquote replaceSingleQuotes\n409:         change String.mk (unescapeChars (cs.flatMap escapeChar ++ ['\\'']).dropLast) = String.mk cs\n410:         rw [dropLast_append_singleton, unescapeChars_flatMap_escapeChar]\n411: \n412: /-- Injectivity of `quote`: distinct input strings always produce distinct shell-escaped strings. -/\n413: theorem quote_injective {s₁ s₂ : String} (h : quote s₁ = quote s₂) : s₁ = s₂ := by\n414:   have h1 := unquote_quote_thm s₁\n415:   have h2 := unquote_quote_thm s₂\n416:   unfold unquote_quote_prop at h1 h2\n417:   rw [← h1, ← h2, h]\n418: \n419: /-! ## 8. Post-condition as Conjunction of Properties -/\n420: \n421: /-- Post-condition combining all semantic properties of `quote`. -/\n422: def Post_prop (s : String) : Prop :=\n423:   empty_string_prop s ∧\n424:   safe_nonempty_prop s ∧\n425:   unsafe_string_prop s ∧\n426:   unsafe_no_single_quote_prop s ∧\n427:   single_quote_escaped_prop s ∧\n428:   nonempty_output_prop s ∧\n429:   length_ge_input_prop s ∧\n430:   unsafe_or_empty_enclosing_quotes_prop s ∧\n431:   unsafe_length_exact_prop s ∧\n432:   safe_idempotent_prop s ∧\n433:   unchanged_iff_safe_nonempty_prop s ∧\n434:   unquote_quote_prop s\n435: \n436: instance (s : String) : Decidable (Post_prop s) := by\n437:   unfold Post_prop; infer_instance\n438: \n439: /-! ## 9. Property-Based Tests -/\n440: \n441: /-- Representative sample corpus covering empty, safe, space-containing, single-quoted,\n442:     double-quoted, mixed, and multi-quote strings for bounded PBTs. -/\n443: def pbtSampleStrings : List String :=\n444:   [ \"\", \"a\", \"abc\", \"ABC_0123456789\", \"_@%+=:,./-\",\n445:     \"a b c\", \" \", \"hello world!\", \"a'b\", \"'\", \"''\", \"'''\",\n446:     \"'hello'\", \"a'b'c\", \"\\\"quoted\\\"\", \"foo$bar\", \"line1\\nline2\",\n447:     \"tab\\there\", \"semi;colon\", \"pipe|cmd\", \"back`tick\", \"a'\\\"'\\\"'b\" ]\n448: \n449: -- Randomized PBTs (via Plausible) for each property and the post-condition\n450: #eval Plausible.Testable.check (∀ s : String, decide (empty_string_prop s) = true)\n451: #eval Plausible.Testable.check (∀ s : String, decide (safe_nonempty_prop s) = true)\n452: #eval Plausible.Testable.check (∀ s : String, decide (unsafe_string_prop s) = true)\n453: #eval Plausible.Testable.check (∀ s : String, decide (unsafe_no_single_quote_prop s) = true)\n454: #eval Plausible.Testable.check (∀ s : String, decide (single_quote_escaped_prop s) = true)\n455: #eval Plausible.Testable.check (∀ s : String, decide (nonempty_output_prop s) = true)\n456: #eval Plausible.Testable.check (∀ s : String, decide (length_ge_input_prop s) = true)\n457: #eval Plausible.Testable.check (∀ s : String, decide (unsafe_or_empty_enclosing_quotes_prop s) = true)\n458: #eval Plausible.Testable.check (∀ s : String, decide (unsafe_length_exact_prop s) = true)\n459: #eval Plausible.Testable.check (∀ s : String, decide (safe_idempotent_prop s) = true)\n460: #eval Plausible.Testable.check (∀ s : String, decide (unchanged_iff_safe_nonempty_prop s) = true)\n461: #eval Plausible.Testable.check (∀ s : String, decide (unquote_quote_prop s) = true)\n462: #eval Plausible.Testable.check (∀ s : String, decide (Post_prop s) = true)\n463: \n464: -- Bounded PBTs across `pbtSampleStrings` for each property and the post-condition\n465: example : pbtSampleStrings.all (fun s => decide (empty_string_prop s)) = true := by native_decide\n466: example : pbtSampleStrings.all (fun s => decide (safe_nonempty_prop s)) = true := by native_decide\n467: example : pbtSampleStrings.all (fun s => decide (unsafe_string_prop s)) = true := by native_decide\n468: example : pbtSampleStrings.all (fun s => decide (unsafe_no_single_quote_prop s)) = true := by native_decide\n469: example : pbtSampleStrings.all (fun s => decide (single_quote_escaped_prop s)) = true := by native_decide\n470: example : pbtSampleStrings.all (fun s => decide (nonempty_output_prop s)) = true := by native_decide\n471: example : pbtSampleStrings.all (fun s => decide (length_ge_input_prop s)) = true := by native_decide\n472: example : pbtSampleStrings.all (fun s => decide (unsafe_or_empty_enclosing_quotes_prop s)) = true := by native_decide\n473: example : pbtSampleStrings.all (fun s => decide (unsafe_length_exact_prop s)) = true := by native_decide\n474: example : pbtSampleStrings.all (fun s => decide (safe_idempotent_prop s)) = true := by native_decide\n475: example : pbtSampleStrings.all (fun s => decide (unchanged_iff_safe_nonempty_prop s)) = true := by native_decide\n476: example : pbtSampleStrings.all (fun s => decide (unquote_quote_prop s)) = true := by native_decide\n477: example : pbtSampleStrings.all (fun s => decide (Post_prop s)) = true := by native_decide\n478: \n479: /-! ## 10. Correctness Theorem (`Pre -> Post`) -/\n480: \n481: /-- Main correctness theorem: for every string `s`, `Pre s` implies `Post_prop s`. -/\n482: theorem quote_correct (s : String) (_hPre : Pre s) : Post_prop s :=\n483:   ⟨empty_string_thm s,\n484:    safe_nonempty_thm s,\n485:    unsafe_string_thm s,\n486:    unsafe_no_single_quote_thm s,\n487:    single_quote_escaped_thm s,\n488:    nonempty_output_thm s,\n489:    length_ge_input_thm s,\n490:    unsafe_or_empty_enclosing_quotes_thm s,\n491:    unsafe_length_exact_thm s,\n492:    safe_idempotent_thm s,\n493:    unchanged_iff_safe_nonempty_thm s,\n494:    unquote_quote_thm s⟩\n495: \n496: /-! ## 11. Imperative Implementation -/\n497: \n498: /-- Imperative implementation of `shlex.quote` using `Id.run do` and mutable state. -/\n499: def quote_imp (s : String) : String := Id.run do\n500:   if s = \"\" then\n501:     \"''\"\n502:   else\n503:     let mut allSafe : Bool := true\n504:     for c in s.toList do\n505:       allSafe := allSafe && isSafeChar c\n506:     if allSafe then\n507:       s\n508:     else\n509:       let mut escaped : List Char := []\n510:       for c in s.toList do\n511:         escaped := escaped ++ (if c == '\\'' then \"'\\\"'\\\"'\".toList else [c])\n512:       \"'\" ++ String.mk escaped ++ \"'\"\n513: \n514: /-! ## 12. Imperative Tests -/\n515: \n516: example : quote_imp \"\" = \"''\" := by native_decide\n517: example : quote_imp \"abc\" = \"abc\" := by native_decide\n518: example : quote_imp \"a b c\" = \"'a b c'\" := by native_decide\n519: example : quote_imp \"a'b\" = \"'a'\\\"'\\\"'b'\" := by native_decide\n520: example : quote_imp \"path/to/file_1.txt\" = \"path/to/file_1.txt\" := by native_decide\n521: example : quote_imp \"'\" = \"''\\\"'\\\"''\" := by native_decide\n522: example : pbtSampleStrings.all (fun s => quote s == quote_imp s) = true := by native_decide\n523: \n524: #eval quote_imp \"\"\n525: #eval quote_imp \"abc\"\n526: #eval quote_imp \"a b c\"\n527: #eval quote_imp \"a'b\"\n528: #eval Plausible.Testable.check (∀ s : String, quote s = quote_imp s)\n529: \n530: /-! ## 13. Equivalence Theorem (Functional = Imperative) -/\n531: \n532: theorem foldl_allSafe (cs : List Char) (init : Bool) :\n533:     cs.foldl (fun acc c => acc && isSafeChar c) init = (init && cs.all isSafeChar) := by\n534:   induction cs generalizing init with\n535:   | nil => simp\n536:   | cons c cs ih =>\n537:     simp only [List.foldl_cons, List.all_cons, ih, Bool.and_assoc]\n538: \n539: /-- Equivalence theorem proving that the functional `quote` and imperative `quote_imp`\n540:     produce identical results on all inputs. -/\n541: theorem quote_equiv (s : String) : quote s = quote_imp s := by\n542:   unfold quote quote_imp replaceSingleQuotes escapeChar\n543:   split\n544:   · rfl\n545:   · simp [foldl_allSafe, List.flatMap_def, Id.run]\n546: \n547: theorem benchmark_quote_equiv (s : String) : benchmark_quote s = quote_imp s :=\n548:   quote_equiv s\n549: \n550: end «21_shlex_quote»"}
