ng s2 with\n  | nil =>\n    simp [edit_distance_nil_left, edit_distance_nil_right]\n  | cons a s1 ih1 =>\n    induction s2 with\n    | nil =>\n      simp [edit_distance_nil_left, edit_distance_nil_right]\n    | cons b s2 ih2 =>\n      simp only [List.reverse_cons]\n      rw [edit_distance_snoc_snoc, edit_distance]\n      have h1 : edit_distance s1.reverse (s2.reverse ++ [b]) = edit_distance s1 (b :: s2) := by\n        rw [← List.reverse_cons]\n        exact ih1 (b :: s2)\n      have h2 : edit_distance (s1.reverse ++ [a]) s2.reverse = edit_distance (a :: s1) s2 := by\n        rw [← List.reverse_cons]\n        exact ih2\n      have h3 : edit_distance s1.reverse s2.reverse = edit_distance s1 s2 := ih1 s2\n      rw [h1, h2, h3]\n\ntheorem edit_distance_common_suffix {α : Type} [DecidableEq α] (s1 s2 p : List α) :\n    edit_distance (s1 ++ p) (s2 ++ p) = edit_distance s1 s2 := by\n  rw [← edit_distance_reverse (s1 ++ p) (s2 ++ p)]\n  simp only [List.reverse_append]\n  rw [edit_distance_common_prefix, edit_distance_reverse]\n\nend edit_distance"}}]}
