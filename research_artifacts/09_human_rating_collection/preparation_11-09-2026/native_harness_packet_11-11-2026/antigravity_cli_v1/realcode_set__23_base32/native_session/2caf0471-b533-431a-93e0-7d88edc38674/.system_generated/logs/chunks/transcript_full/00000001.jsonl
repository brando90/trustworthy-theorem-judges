\n\ntheorem b32AlphabetGet_ne_eq (i : Nat) :\n    (b32AlphabetGet i == 61) = false := by\n  rw [beq_eq_false_iff_ne, ne_eq, ← UInt8.toNat_inj]\n  unfold b32AlphabetGet\n  dsimp only\n  split_ifs <;> simp [UInt8.toNat_ofNat] <;> omega\n\ntheorem nat_and_31 (n : Nat) : n &&& 0x1F = n % 32 := by\n  change n &&& (2^5 - 1) = n % 2^5\n  exact Nat.and_two_pow_sub_one_eq_mod n 5\n\ntheorem nat_and_255 (n : Nat) : n &&& 0xFF = n % 256 := by\n  change n &&& (2^8 - 1) = n % 2^8\n  exact Nat.and_two_pow_sub_one_eq_mod n 8\n\ntheorem shiftLeft5_or_eq (v d : Nat) (hd : d < 32) : (v <<< 5) ||| d = v * 32 + d := by\n  have hd' : d < 2^5 := hd\n  rw [show v * 32 = 2^5 * v by omega]\n  apply Nat.eq_of_testBit_eq\n  intro i\n  rw [Nat.testBit_lor, Nat.testBit_shiftLeft, Nat.testBit_two_pow_mul_add _ hd']\n  rcases lt_or_ge i 5 with hi | hi\n  · have h1 : ¬(i ≥ 5) := by omega\n    simp [hi, h1]\n  · have h2 : d < 2^i := lt_of_lt_of_le hd' (Nat.pow_le_pow_right (by omega) hi)\n    have h3 : d.testBit i = false := Nat.testBit_lt_two_pow h2\n    have h4 : ¬(i < 5) := by omega\n    simp [hi, h3, h4]\n\ndef rstripEq : Bytes → Bytes\n  | [] => []\n  | x :: xs =>\n    match rstripEq xs with\n    | [] => if x == 61 then [] else [x]\n    | r => x :: r\n\ntheorem rstripEq_cons_of_ne (x : UInt8) (xs : Bytes) (h : (x == 61) = false) :\n    rstripEq (x :: xs) = x :: rstripEq xs := by\n  rw [rstripEq.eq_2]\n  cases rstripEq xs <;> simp [h]\n\n@[simp]\ntheorem rstripEq_b32AlphabetGet_cons (i : Nat) (xs : Bytes) :\n    rstripEq (b32AlphabetGet i :: xs) = b32AlphabetGet i :: rstripEq xs :=\n  rstripEq_cons_of_ne _ xs (b32AlphabetGet_ne_eq i)\n\ndef decodeLoop : Bytes → Nat → Nat → Option Bytes\n  | [], _, _ => some []\n  | c :: cs, val, bits =>\n    match revAlphabet c with\n    | none => none\n    | some d =>\n      let val' := (val <<< 5) ||| d\n      let bits' := bits + 5\n      if bits' ≥ 8 then\n        let bits'' := bits' - 8\n        let byte := UInt8.ofNat ((val' >>> bits'') &&& 0xFF)\n        match decodeLoop cs val' bits'' with\n        | none => none\n        | some rest => some (byte :: rest)\n      else\n        decodeLoop cs val' bits'\n\ntheorem decodeLoop_step_lt (i : Nat) (cs : Bytes) (val bits : Nat) (h : ¬(bits + 5 ≥ 8)) :\n    decodeLoop (b32AlphabetGet i :: cs) val bits =\n      decodeLoop cs (val * 32 + i % 32) (bits + 5) := by\n  rw [decodeLoop.eq_2, revAlphabet_b32AlphabetGet]\n  dsimp only\n  rw [if_neg h, shiftLeft5_or_eq val (i % 32) (Nat.mod_lt _ (by decide))]\n\ntheorem decodeLoop_step_ge (i : Nat) (cs : Bytes) (val bits : Nat) (h : bits + 5 ≥ 8) :\n    decodeLoop (b32AlphabetGet i :: cs) val bits =\n      let val' := val * 32 + i % 32\n      let bits'' := bits + 5 - 8\n      let byte := UInt8.ofNat ((val' / 2^bits'') % 256)\n      match decodeLoop cs val' bits'' with\n      | none => none\n      | some rest => some (byte :: rest) := by\n  rw [decodeLoop.eq_2, revAlphabet_b32AlphabetGet]\n  dsimp only\n  rw [if_pos h, shiftLeft5_or_eq val (i % 32) (Nat.mod_lt _ (by decide)),\n    Nat.shiftRight_eq_div_pow, nat_and_255]\nEOF\n","WaitMsBeforeAsync":10000,"toolSummary":"Test decodeLoop_step_lt and decodeLoop_step_ge lemmas"}}]}
