at) :\n    revAlphabet (b32AlphabetGet i) = some (i % 32) := by\n  unfold revAlphabet b32AlphabetGet\n  dsimp only\n  split_ifs <;> simp_all [UInt8.toNat_ofNat] <;> omega\n\ntheorem b32AlphabetGet_ne_eq (i : Nat) :\n    (b32AlphabetGet i == 61) = false := by\n  rw [beq_eq_false_iff_ne, ne_eq, ← UInt8.toNat_inj]\n  unfold b32AlphabetGet\n  dsimp only\n  split_ifs <;> simp [UInt8.toNat_ofNat] <;> omega\n\ndef isB32EncodedChar (c : UInt8) : Bool :=\n  (revAlphabet c).isSome || (c == 61)\n\ntheorem isB32EncodedChar_b32AlphabetGet (i : Nat) :\n    isB32EncodedChar (b32AlphabetGet i) = true := by\n  simp [isB32EncodedChar, revAlphabet_b32AlphabetGet]\n\ntheorem isB32EncodedChar_pad : isB32EncodedChar 61 = true := by\n  decide\n\ndef replaceByte (s : Bytes) (old new_ : UInt8) : Bytes :=\n  s.map (fun c => if c == old then new_ else c)\n\ndef applyMap01 (s : Bytes) (map01 : Option UInt8) : Bytes :=\n  match map01 with\n  | none => s\n  | some m => replaceByte (replaceByte s 48 79) 49 m\n\ndef toUpperByte (c : UInt8) : UInt8 :=\n  if 97 ≤ c.toNat ∧ c.toNat ≤ 122 then UInt8.ofNat (c.toNat - 32) else c\n\ndef toUpperAscii (s : Bytes) : Bytes :=\n  s.map toUpperByte\n\ndef toLowerByte (c : UInt8) : UInt8 :=\n  if 65 ≤ c.toNat ∧ c.toNat ≤ 90 then UInt8.ofNat (c.toNat + 32) else c\n\ndef toLowerAscii (s : Bytes) : Bytes :=\n  s.map toLowerByte\n\ntheorem b32EncodedChar_props (c : UInt8) (h : isB32EncodedChar c = true) :\n    (c == 48) = false ∧ (c == 49) = false ∧\n    toUpperByte c = c ∧ toUpperByte (toLowerByte c) = c := by\n  revert h\n  decide\n\ntheorem replaceByte_eq_self (s : Bytes) (old new_ : UInt8)\n    (h : ∀ c ∈ s, (c == old) = false) :\n    replaceByte s old new_ = s := by\n  unfold replaceByte\n  induction s with\n  | nil => rfl\n  | cons x xs ih =>\n    simp only [List.map_cons, h x (List.mem_cons_self ..), ↓reduceIte, List.cons.injEq, true_and]\n    exact ih (fun c hc => h c (List.mem_cons_of_mem x hc))\n\ntheorem toUpperAscii_eq_self (s : Bytes) (h : ∀ c ∈ s, isB