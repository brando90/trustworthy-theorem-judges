{"step_index":56,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-16T22:08:24Z","content":"Created At: 2026-11-16T22:08:24Z\nCompleted At: 2026-11-16T22:08:24Z\nCreated At: 2026-11-16T22:08:24Z\nCompleted At: 2026-11-16T22:08:24Z\nShowing lines 1-665 of 665\n1: import Mathlib\n2: \n3: /-!\n4: # 20_MySumDigits: Sum of Digits in a Non-Negative Integer\n5: \n6: This module formalizes the Python program that computes the sum of base-10 digits\n7: of a non-negative integer `n`.\n8: \n9: ## Structure\n10: 1. Functional implementation (`sumDigits`, `sumDigits?`)\n11: 2. Unit tests (`example` with `native_decide` and `#eval`)\n12: 3. Pre-condition predicate (`Pre`)\n13: 4. Property propositions (`<name>_prop`) and kernel-checked theorems (`<name>_thm`)\n14: 5. Post-condition predicate (`Post_prop`)\n15: 6. Property-based tests (Plausible randomized checks and bounded `native_decide` checks)\n16: 7. Correctness theorem (`Pre → Post_prop`)\n17: 8. Imperative implementation using `Id.run do` with mutable state (`sumDigitsImp`, `sumDigitsImp?`)\n18: 9. Imperative unit tests\n19: 10. Equivalence theorems (`sumDigits n = sumDigitsImp n` and `sumDigits? n = sumDigitsImp? n`)\n20: -/\n21: \n22: namespace «20_MySumDigits»\n23: \n24: /-! ## Implementation (Functional Definition) -/\n25: \n26: /-- Functional implementation returning the sum of base-10 digits of an integer `n`.\n27: For `n ≤ 0`, it returns `0`; for `n > 0`, it recursively adds `n % 10` to `sumDigits (n / 10)`. -/\n28: def sumDigits (n : Int) : Int :=\n29:   if n ≤ 0 then 0\n30:   else n % 10 + sumDigits (n / 10)\n31: termination_by n.toNat\n32: \n33: abbrev mySumDigits : Int → Int := sumDigits\n34: abbrev prog : Int → Int := sumDigits\n35: \n36: /-- Executable boolean precondition check corresponding to Python's `pre(n)`. -/\n37: def preCheck (n : Int) : Bool :=\n38:   decide (n ≥ 0)\n39: \n40: /-- Checked functional implementation modeling Python's `ValueError` on negative inputs\n41: by returning `none` when `n < 0` and `some (sumDigits n)` when `n ≥ 0`. -/\n42: def sumDigits? (n : Int) : Option Int :=\n43:   if n ≥ 0 then some (sumDigits n) else none\n44: \n45: abbrev prog? : Int → Option Int := sumDigits?\n46: \n47: /-! ## Unit Tests -/\n48: \n49: example : sumDigits 123 = 6 := by native_decide\n50: example : sumDigits 0 = 0 := by native_decide\n51: example : sumDigits 1 = 1 := by native_decide\n52: example : sumDigits 7 = 7 := by native_decide\n53: example : sumDigits 9 = 9 := by native_decide\n54: example : sumDigits 10 = 1 := by native_decide\n55: example : sumDigits 99 = 18 := by native_decide\n56: example : sumDigits 999 = 27 := by native_decide\n57: example : sumDigits 10005 = 6 := by native_decide\n58: example : sumDigits (-1) = 0 := by native_decide\n59: \n60: example : sumDigits? 123 = some 6 := by native_decide\n61: example : sumDigits? 0 = some 0 := by native_decide\n62: example : sumDigits? 7 = some 7 := by native_decide\n63: example : sumDigits? (-1) = none := by native_decide\n64: example : sumDigits? (-42) = none := by native_decide\n65: \n66: #eval sumDigits 123\n67: #eval sumDigits 0\n68: #eval sumDigits 7\n69: #eval sumDigits 999\n70: #eval sumDigits? 123\n71: #eval sumDigits? 0\n72: #eval sumDigits? (-1)\n73: \n74: /-! ## Pre-Condition Predicate -/\n75: \n76: /-- Pre-condition: `n` is a non-negative integer (`n ≥ 0`). -/\n77: def Pre (n : Int) : Prop :=\n78:   n ≥ 0\n79: \n80: instance (n : Int) : Decidable (Pre n) :=\n81:   inferInstanceAs (Decidable (n ≥ 0))\n82: \n83: /-! ## Helper Lemmas for Functional Implementation -/\n84: \n85: theorem sumDigits_le_zero {n : Int} (h : n ≤ 0) : sumDigits n = 0 := by\n86:   unfold sumDigits\n87:   simp [h]\n88: \n89: theorem sumDigits_zero : sumDigits 0 = 0 :=\n90:   sumDigits_le_zero (le_refl 0)\n91: \n92: theorem sumDigits_pos_step {n : Int} (h : 0 < n) :\n93:     sumDigits n = n % 10 + sumDigits (n / 10) := by\n94:   conv_lhs => unfold sumDigits\n95:   have h1 : ¬ (n ≤ 0) := by omega\n96:   simp [h1]\n97: \n98: theorem sumDigits_nonneg_all (n : Int) : 0 ≤ sumDigits n := by\n99:   induction n using sumDigits.induct with\n100:   | case1 n hn =>\n101:     simp [sumDigits_le_zero hn]\n102:   | case2 n hn ih =>\n103:     have hpos : 0 < n := by omega\n104:     rw [sumDigits_pos_step hpos]\n105:     omega\n106: \n107: theorem sumDigits_pos_of_pos {n : Int} (h : 0 < n) : 0 < sumDigits n := by\n108:   induction n using sumDigits.induct with\n109:   | case1 n hn => omega\n110:   | case2 n hn ih =>\n111:     have hpos : 0 < n := by omega\n112:     rw [sumDigits_pos_step hpos]\n113:     by_cases hdiv : 0 < n / 10\n114:     · have := ih hdiv\n115:       omega\n116:     · have : n % 10 > 0 := by omega\n117:       have := sumDigits_nonneg_all (n / 10)\n118:       omega\n119: \n120: theorem sumDigits_single_digit_aux {n : Int} (h0 : 0 ≤ n) (h10 : n < 10) :\n121:     sumDigits n = n := by\n122:   by_cases hz : n ≤ 0\n123:   · have : n = 0 := by omega\n124:     subst this\n125:     exact sumDigits_zero\n126:   · have hpos : 0 < n := by omega\n127:     rw [sumDigits_pos_step hpos]\n128:     have hdiv : n / 10 ≤ 0 := by omega\n129:     rw [sumDigits_le_zero hdiv]\n130:     omega\n131: \n132: /-! ## Property Propositions and Theorems -/\n133: \n134: /-- Property 1: The sum of digits is always non-negative (`sumDigits n ≥ 0`). -/\n135: def nonneg_prop (n : Int) : Prop :=\n136:   sumDigits n ≥ 0\n137: \n138: instance (n : Int) : Decidable (nonneg_prop n) :=\n139:   inferInstanceAs (Decidable (sumDigits n ≥ 0))\n140: \n141: theorem nonneg_thm (n : Int) (_h : Pre n) : nonneg_prop n :=\n142:   sumDigits_nonneg_all n\n143: \n144: /-- Property 2: Edge case for `0` — the sum of digits of `0` is `0`. -/\n145: def zero_prop (n : Int) : Prop :=\n146:   n = 0 → sumDigits n = 0\n147: \n148: instance (n : Int) : Decidable (zero_prop n) :=\n149:   inferInstanceAs (Decidable (n = 0 → sumDigits n = 0))\n150: \n151: theorem zero_thm (n : Int) (_h : Pre n) : zero_prop n := by\n152:   intro hn\n153:   subst hn\n154:   exact sumDigits_zero\n155: \n156: /-- Property 3: For non-negative `n`, `sumDigits n = 0` if and only if `n = 0`. -/\n157: def zero_iff_prop (n : Int) : Prop :=\n158:   sumDigits n = 0 ↔ n = 0\n159: \n160: instance (n : Int) : Decidable (zero_iff_prop n) :=\n161:   inferInstanceAs (Decidable (sumDigits n = 0 ↔ n = 0))\n162: \n163: theorem zero_iff_thm (n : Int) (h : Pre n) : zero_iff_prop n := by\n164:   unfold zero_iff_prop\n165:   unfold Pre at h\n166:   constructor\n167:   · intro hsum\n168:     by_contra hne\n169:     have hpos : 0 < n := by omega\n170:     have hsum_pos := sumDigits_pos_of_pos hpos\n171:     omega\n172:   · intro hn\n173:     subst hn\n174:     exact sumDigits_zero\n175: \n176: /-- Property 4: For strictly positive `n`, the sum of digits is strictly positive (`sumDigits n > 0`). -/\n177: def pos_prop (n : Int) : Prop :=\n178:   n > 0 → sumDigits n > 0\n179: \n180: instance (n : Int) : Decidable (pos_prop n) :=\n181:   inferInstanceAs (Decidable (n > 0 → sumDigits n > 0))\n182: \n183: theorem pos_thm (n : Int) (_h : Pre n) : pos_prop n := by\n184:   intro hpos\n185:   exact sumDigits_pos_of_pos hpos\n186: \n187: /-- Property 5: Single-digit non-negative numbers (`0 ≤ n < 10`) return themselves. -/\n188: def single_digit_prop (n : Int) : Prop :=\n189:   (0 ≤ n ∧ n < 10) → sumDigits n = n\n190: \n191: instance (n : Int) : Decidable (single_digit_prop n) :=\n192:   inferInstanceAs (Decidable ((0 ≤ n ∧ n < 10) → sumDigits n = n))\n193: \n194: theorem single_digit_thm (n : Int) (_h : Pre n) : single_digit_prop n := by\n195:   intro ⟨h0, h10⟩\n196:   exact sumDigits_single_digit_aux h0 h10\n197: \n198: /-- Property 6: Recurrence step for positive integers (`n > 0 → sumDigits n = n % 10 + sumDigits (n / 10)`). -/\n199: def recurrence_prop (n : Int) : Prop :=\n200:   n > 0 → sumDigits n = n % 10 + sumDigits (n / 10)\n201: \n202: instance (n : Int) : Decidable (recurrence_prop n) :=\n203:   inferInstanceAs (Decidable (n > 0 → sumDigits n = n % 10 + sumDigits (n / 10)))\n204: \n205: theorem recurrence_thm (n : Int) (_h : Pre n) : recurrence_prop n := by\n206:   intro hpos\n207:   exact sumDigits_pos_step hpos\n208: \n209: /-- Property 7: Base-10 digit decomposition holds for all non-negative integers `n`. -/\n210: def decomp_prop (n : Int) : Prop :=\n211:   sumDigits n = n % 10 + sumDigits (n / 10)\n212: \n213: instance (n : Int) : Decidable (decomp_prop n) :=\n214:   inferInstanceAs (Decidable (sumDigits n = n % 10 + sumDigits (n / 10)))\n215: \n216: theorem decomp_thm (n : Int) (h : Pre n) : decomp_prop n := by\n217:   unfold decomp_prop\n218:   unfold Pre at h\n219:   by_cases hz : n = 0\n220:   · subst hz\n221:     simp [sumDigits_zero]\n222:   · have hpos : 0 < n := by omega\n223:     exact sumDigits_pos_step hpos\n224: \n225: /-- Property 8: The sum of digits of a non-negative integer never exceeds the integer itself (`sumDigits n ≤ n`). -/\n226: def le_self_prop (n : Int) : Prop :=\n227:   sumDigits n ≤ n\n228: \n229: instance (n : Int) : Decidable (le_self_prop n) :=\n230:   inferInstanceAs (Decidable (sumDigits n ≤ n))\n231: \n232: theorem le_self_thm (n : Int) (h : Pre n) : le_self_prop n := by\n233:   unfold le_self_prop\n234:   unfold Pre at h\n235:   induction n using sumDigits.induct with\n236:   | case1 n hn =>\n237:     rw [sumDigits_le_zero hn]\n238:     omega\n239:   | case2 n hn ih =>\n240:     have hpos : 0 < n := by omega\n241:     rw [sumDigits_pos_step hpos]\n242:     have hdiv_nonneg : 0 ≤ n / 10 := by omega\n243:     have ih_step := ih hdiv_nonneg\n244:     omega\n245: \n246: /-- Property 9: For multi-digit integers (`n ≥ 10`), the sum of digits is strictly less than `n`. -/\n247: def lt_self_prop (n : Int) : Prop :=\n248:   n ≥ 10 → sumDigits n < n\n249: \n250: instance (n : Int) : Decidable (lt_self_prop n) :=\n251:   inferInstanceAs (Decidable (n ≥ 10 → sumDigits n < n))\n252: \n253: theorem lt_self_thm (n : Int) (_h : Pre n) : lt_self_prop n := by\n254:   intro h10\n255:   have hpos : 0 < n := by omega\n256:   rw [sumDigits_pos_step hpos]\n257:   have hdiv_nonneg : Pre (n / 10) := by\n258:     unfold Pre\n259:     omega\n260:   have hle : sumDigits (n / 10) ≤ n / 10 := le_self_thm (n / 10) hdiv_nonneg\n261:   omega\n262: \n263: /-- Property 10: Congruence modulo 9 (casting out nines: `sumDigits n % 9 = n % 9`). -/\n264: def mod_nine_prop (n : Int) : Prop :=\n265:   sumDigits n % 9 = n % 9\n266: \n267: instance (n : Int) : Decidable (mod_nine_prop n) :=\n268:   inferInstanceAs (Decidable (sumDigits n % 9 = n % 9))\n269: \n270: theorem mod_nine_thm (n : Int) (h : Pre n) : mod_nine_prop n := by\n271:   unfold mod_nine_prop\n272:   unfold Pre at h\n273:   induction n using sumDigits.induct with\n274:   | case1 n hn =>\n275:     have : n = 0 := by omega\n276:     subst this\n277:     simp [sumDigits_zero]\n278:   | case2 n hn ih =>\n279:     have hpos : 0 < n := by omega\n280:     rw [sumDigits_pos_step hpos]\n281:     have hdiv_nonneg : 0 ≤ n / 10 := by omega\n282:     have ih_step := ih hdiv_nonneg\n283:     omega\n284: \n285: /-- Property 11: Appending a base-10 digit `d` (`0 ≤ d < 10`) adds `d` to the digit sum. -/\n286: def append_digit_prop (n d : Int) : Prop :=\n287:   (0 ≤ d ∧ d < 10) → sumDigits (10 * n + d) = sumDigits n + d\n288: \n289: instance (n d : Int) : Decidable (append_digit_prop n d) :=\n290:   inferInstanceAs (Decidable ((0 ≤ d ∧ d < 10) → sumDigits (10 * n + d) = sumDigits n + d))\n291: \n292: theorem append_digit_thm (n d : Int) (h : Pre n) : append_digit_prop n d := by\n293:   unfold append_digit_prop\n294:   unfold Pre at h\n295:   intro ⟨hd0, hd10⟩\n296:   by_cases h0 : 10 * n + d ≤ 0\n297:   · have hn0 : n = 0 := by omega\n298:     have hd_zero : d = 0 := by omega\n299:     subst hn0 hd_zero\n300:     simp [sumDigits_zero]\n301:   · have hpos : 0 < 10 * n + d := by omega\n302:     rw [sumDigits_pos_step hpos]\n303:     have hdiv : (10 * n + d) / 10 = n := by omega\n304:     have hmod : (10 * n + d) % 10 = d := by omega\n305:     rw [hdiv, hmod]\n306:     omega\n307: \n308: /-- Property 12: Multiplying a non-negative integer by 10 preserves the sum of digits. -/\n309: def scale_ten_prop (n : Int) : Prop :=\n310:   sumDigits (10 * n) = sumDigits n\n311: \n312: instance (n : Int) : Decidable (scale_ten_prop n) :=\n313:   inferInstanceAs (Decidable (sumDigits (10 * n) = sumDigits n))\n314: \n315: theorem scale_ten_thm (n : Int) (h : Pre n) : scale_ten_prop n := by\n316:   unfold scale_ten_prop\n317:   have happ := append_digit_thm n 0 h ⟨le_refl 0, by decide⟩\n318:   simpa using happ\n319: \n320: /-- Property 13: Incrementing a non-negative integer by 1 increases the digit sum by at most 1. -/\n321: def succ_bound_prop (n : Int) : Prop :=\n322:   sumDigits (n + 1) ≤ sumDigits n + 1\n323: \n324: instance (n : Int) : Decidable (succ_bound_prop n) :=\n325:   inferInstanceAs (Decidable (sumDigits (n + 1) ≤ sumDigits n + 1))\n326: \n327: theorem succ_bound_thm (n : Int) (h : Pre n) : succ_bound_prop n := by\n328:   unfold succ_bound_prop\n329:   unfold Pre at h\n330:   induction n using sumDigits.induct with\n331:   | case1 n hn0 =>\n332:     have : n = 0 := by omega\n333:     subst this\n334:     have h1 : sumDigits 1 = 1 := sumDigits_single_digit_aux (by omega) (by omega)\n335:     simp only [zero_add, h1, sumDigits_zero]\n336:     omega\n337:   | case2 n hn0 ih =>\n338:     have hpos : 0 < n := by omega\n339:     have hpos1 : 0 < n + 1 := by omega\n340:     rw [sumDigits_pos_step hpos, sumDigits_pos_step hpos1]\n341:     by_cases h9 : n % 10 < 9\n342:     · have hdiv : (n + 1) / 10 = n / 10 := by omega\n343:       have hmod : (n + 1) % 10 = n % 10 + 1 := by omega\n344:       rw [hdiv, hmod]\n345:       omega\n346:     · have hdiv : (n + 1) / 10 = n / 10 + 1 := by omega\n347:       have hmod : (n + 1) % 10 = 0 := by omega\n348:       have hmodn : n % 10 = 9 := by omega\n349:       rw [hdiv, hmod]\n350:       have ih_step := ih (by omega)\n351:       omega\n352: \n353: /-- Property 14: Subadditivity — `sumDigits (a + b) ≤ sumDigits a + sumDigits b` for non-negative `a, b`. -/\n354: def subadd_prop (a b : Int) : Prop :=\n355:   sumDigits (a + b) ≤ sumDigits a + sumDigits b\n356: \n357: instance (a b : Int) : Decidable (subadd_prop a b) :=\n358:   inferInstanceAs (Decidable (sumDigits (a + b) ≤ sumDigits a + sumDigits b))\n359: \n360: theorem subadd_thm (a b : Int) (ha : Pre a) (hb : Pre b) : subadd_prop a b := by\n361:   unfold subadd_prop\n362:   unfold Pre at ha hb\n363:   induction a using sumDigits.induct generalizing b with\n364:   | case1 a ha0 =>\n365:     have : a = 0 := by omega\n366:     subst this\n367:     simp [sumDigits_zero]\n368:   | case2 a ha0 ih =>\n369:     have hapos : 0 < a := by omega\n370:     by_cases hb0 : b ≤ 0\n371:     · have : b = 0 := by omega\n372:       subst this\n373:       simp [sumDigits_zero]\n374:     · have hbpos : 0 < b := by omega\n375:       have habpos : 0 < a + b := by omega\n376:       rw [sumDigits_pos_step hapos, sumDigits_pos_step hbpos, sumDigits_pos_step habpos]\n377:       by_cases hcarry : a % 10 + b % 10 < 10\n378:       · have hdiv : (a + b) / 10 = a / 10 + b / 10 := by omega\n379:         have hmod : (a + b) % 10 = a % 10 + b % 10 := by omega\n380:         rw [hdiv, hmod]\n381:         have ih1 := ih (by omega) (b := b / 10) (by omega)\n382:         omega\n383:       · have hdiv : (a + b) / 10 = a / 10 + (b / 10 + 1) := by omega\n384:         have hmod : (a + b) % 10 = a % 10 + b % 10 - 10 := by omega\n385:         rw [hdiv, hmod]\n386:         have ih1 := ih (by omega) (b := b / 10 + 1) (by omega)\n387:         have hsucc : sumDigits (b / 10 + 1) ≤ sumDigits (b / 10) + 1 :=\n388:           succ_bound_thm (b / 10) (by unfold Pre; omega)\n389:         omega\n390: \n391: /-- Property 15: Exact correspondence with Mathlib's `Nat.digits 10`. -/\n392: def digits_sum_prop (n : Int) : Prop :=\n393:   sumDigits n = ((Nat.digits 10 n.toNat).sum : Int)\n394: \n395: instance (n : Int) : Decidable (digits_sum_prop n) :=\n396:   inferInstanceAs (Decidable (sumDigits n = ((Nat.digits 10 n.toNat).sum : Int)))\n397: \n398: theorem digits_sum_thm (n : Int) (_h : Pre n) : digits_sum_prop n := by\n399:   clear _h\n400:   unfold digits_sum_prop\n401:   induction n using sumDigits.induct with\n402:   | case1 n hn =>\n403:     have htoNat : n.toNat = 0 := by omega\n404:     simp [sumDigits_le_zero hn, htoNat]\n405:   | case2 n hn ih =>\n406:     have hpos : 0 < n := by omega\n407:     rw [sumDigits_pos_step hpos, ih]\n408:     have htoNat_pos : 0 < n.toNat := by omega\n409:     rw [Nat.digits_def' (by decide : 1 < 10) htoNat_pos]\n410:     simp only [List.sum_cons, Nat.cast_add]\n411:     have hmod : ((n.toNat % 10 : Nat) : Int) = n % 10 := by omega\n412:     have hdiv : n.toNat / 10 = (n / 10).toNat := by omega\n413:     rw [hmod, hdiv]\n414: \n415: /-- Property 16: On valid inputs (`Pre n`), `sumDigits? n` returns `some (sumDigits n)`. -/\n416: def checked_valid_prop (n : Int) : Prop :=\n417:   sumDigits? n = some (sumDigits n)\n418: \n419: instance (n : Int) : Decidable (checked_valid_prop n) :=\n420:   inferInstanceAs (Decidable (sumDigits? n = some (sumDigits n)))\n421: \n422: theorem checked_valid_thm (n : Int) (h : Pre n) : checked_valid_prop n := by\n423:   unfold checked_valid_prop sumDigits?\n424:   unfold Pre at h\n425:   simp [h]\n426: \n427: /-- Property 17: On negative inputs (`n < 0`), `sumDigits? n` returns `none` (modeling `ValueError`). -/\n428: def checked_neg_prop (n : Int) : Prop :=\n429:   n < 0 → sumDigits? n = none\n430: \n431: instance (n : Int) : Decidable (checked_neg_prop n) :=\n432:   inferInstanceAs (Decidable (n < 0 → sumDigits? n = none))\n433: \n434: theorem checked_neg_thm (n : Int) : checked_neg_prop n := by\n435:   unfold checked_neg_prop sumDigits?\n436:   intro hneg\n437:   have hnot : ¬ (n ≥ 0) := by omega\n438:   simp [hnot]\n439: \n440: /-! ## Post-Condition -/\n441: \n442: /-- Post-condition conjunction of properties for a valid input `n`. -/\n443: def Post_prop (n : Int) : Prop :=\n444:   nonneg_prop n ∧\n445:   zero_prop n ∧\n446:   zero_iff_prop n ∧\n447:   pos_prop n ∧\n448:   single_digit_prop n ∧\n449:   recurrence_prop n ∧\n450:   decomp_prop n ∧\n451:   le_self_prop n ∧\n452:   lt_self_prop n ∧\n453:   mod_nine_prop n ∧\n454:   scale_ten_prop n ∧\n455:   succ_bound_prop n ∧\n456:   digits_sum_prop n ∧\n457:   checked_valid_prop n\n458: \n459: instance (n : Int) : Decidable (Post_prop n) :=\n460:   inferInstanceAs (Decidable (\n461:     nonneg_prop n ∧\n462:     zero_prop n ∧\n463:     zero_iff_prop n ∧\n464:     pos_prop n ∧\n465:     single_digit_prop n ∧\n466:     recurrence_prop n ∧\n467:     decomp_prop n ∧\n468:     le_self_prop n ∧\n469:     lt_self_prop n ∧\n470:     mod_nine_prop n ∧\n471:     scale_ten_prop n ∧\n472:     succ_bound_prop n ∧\n473:     digits_sum_prop n ∧\n474:     checked_valid_prop n))\n475: \n476: /-! ## Property-Based Tests -/\n477: \n478: -- Randomized PBTs with Plausible\n479: #eval Plausible.Testable.check (∀ n : Int, Pre n → nonneg_prop n) { numRetries := 20 }\n480: #eval Plausible.Testable.check (∀ n : Int, Pre n → zero_prop n) { numRetries := 20 }\n481: #eval Plausible.Testable.check (∀ n : Int, Pre n → zero_iff_prop n) { numRetries := 20 }\n482: #eval Plausible.Testable.check (∀ n : Int, Pre n → pos_prop n) { numRetries := 20 }\n483: #eval Plausible.Testable.check (∀ n : Int, Pre n → single_digit_prop n) { numRetries := 20 }\n484: #eval Plausible.Testable.check (∀ n : Int, Pre n → recurrence_prop n) { numRetries := 20 }\n485: #eval Plausible.Testable.check (∀ n : Int, Pre n → decomp_prop n) { numRetries := 20 }\n486: #eval Plausible.Testable.check (∀ n : Int, Pre n → le_self_prop n) { numRetries := 20 }\n487: #eval Plausible.Testable.check (∀ n : Int, Pre n → lt_self_prop n) { numRetries := 20 }\n488: #eval Plausible.Testable.check (∀ n : Int, Pre n → mod_nine_prop n) { numRetries := 20 }\n489: #eval Plausible.Testable.check (∀ (n d : Int), Pre n → append_digit_prop n d) { numRetries := 20 }\n490: #eval Plausible.Testable.check (∀ n : Int, Pre n → scale_ten_prop n) { numRetries := 20 }\n491: #eval Plausible.Testable.check (∀ n : Int, Pre n → succ_bound_prop n) { numRetries := 20 }\n492: #eval Plausible.Testable.check (∀ a b : Int, Pre a → Pre b → subadd_prop a b) { numRetries := 20 }\n493: #eval Plausible.Testable.check (∀ n : Int, Pre n → digits_sum_prop n) { numRetries := 20 }\n494: #eval Plausible.Testable.check (∀ n : Int, Pre n → checked_valid_prop n) { numRetries := 20 }\n495: #eval Plausible.Testable.check (∀ n : Int, checked_neg_prop n) { numRetries := 20 }\n496: #eval Plausible.Testable.check (∀ n : Int, Pre n → Post_prop n) { numRetries := 20 }\n497: \n498: -- Bounded exhaustive PBTs over executable Boolean forms\n499: example : (List.range 250).all (fun k => sumDigits (k : Int) ≥ 0) = true := by native_decide\n500: example : (List.range 250).all (fun k => !(k == 0) || sumDigits (k : Int) == 0) = true := by native_decide\n501: example : (List.range 250).all (fun k => (sumDigits (k : Int) == 0) == (k == 0)) = true := by native_decide\n502: example : (List.range 250).all (fun k => !(k > 0) || sumDigits (k : Int) > 0) = true := by native_decide\n503: example : (List.range 250).all (fun k => !(k < 10) || sumDigits (k : Int) == (k : Int)) = true := by native_decide\n504: example : (List.range 250).all (fun k =>\n505:     !(k > 0) || sumDigits (k : Int) == (k : Int) % 10 + sumDigits ((k : Int) / 10)) = true := by native_decide\n506: example : (List.range 250).all (fun k =>\n507:     sumDigits (k : Int) == (k : Int) % 10 + sumDigits ((k : Int) / 10)) = true := by native_decide\n508: example : (List.range 250).all (fun k => sumDigits (k : Int) ≤ (k : Int)) = true := by native_decide\n509: example : (List.range 250).all (fun k => !(k ≥ 10) || sumDigits (k : Int) < (k : Int)) = true := by native_decide\n510: example : (List.range 250).all (fun k => sumDigits (k : Int) % 9 == (k : Int) % 9) = true := by native_decide\n511: example : (List.range 50).all (fun k =>\n512:     (List.range 10).all (fun d =>\n513:       sumDigits (10 * (k : Int) + (d : Int)) == sumDigits (k : Int) + (d : Int))) = true := by native_decide\n514: example : (List.range 250).all (fun k => sumDigits (10 * (k : Int)) == sumDigits (k : Int)) = true := by native_decide\n515: example : (List.range 250).all (fun k => sumDigits ((k : Int) + 1) ≤ sumDigits (k : Int) + 1) = true := by native_decide\n516: example : (List.range 40).all (fun a =>\n517:     (List.range 40).all (fun b =>\n518:       sumDigits ((a : Int) + (b : Int)) ≤ sumDigits (a : Int) + sumDigits (b : Int))) = true := by native_decide\n519: example : (List.range 250).all (fun k =>\n520:     sumDigits (k : Int) == ((Nat.digits 10 k).sum : Int)) = true := by native_decide\n521: example : (List.range 250).all (fun k =>\n522:     sumDigits? (k : Int) == some (sumDigits (k : Int))) = true := by native_decide\n523: example : (List.range 100).all (fun k =>\n524:     sumDigits? (-(k : Int) - 1) == none) = true := by native_decide\n525: example : (List.range 250).all (fun k => decide (Post_prop (k : Int))) = true := by native_decide\n526: \n527: /-! ## Correctness Theorem: `Pre -> Post` -/\n528: \n529: /-- Main correctness theorem: every integer `n` satisfying `Pre n` satisfies `Post_prop n`. -/\n530: theorem correctness_thm (n : Int) (h : Pre n) : Post_prop n :=\n531:   ⟨nonneg_thm n h,\n532:    zero_thm n h,\n533:    zero_iff_thm n h,\n534:    pos_thm n h,\n535:    single_digit_thm n h,\n536:    recurrence_thm n h,\n537:    decomp_thm n h,\n538:    le_self_thm n h,\n539:    lt_self_thm n h,\n540:    mod_nine_thm n h,\n541:    scale_ten_thm n h,\n542:    succ_bound_thm n h,\n543:    digits_sum_thm n h,\n544:    checked_valid_thm n h⟩\n545: \n546: abbrev sumDigits_correct : ∀ n : Int, Pre n → Post_prop n := correctness_thm\n547: \n548: /-! ## Imperative Implementation -/\n549: \n550: /-- Imperative implementation of `sumDigits` using `Id.run do` and mutable state. -/\n551: def sumDigitsImp (n : Int) : Int := Id.run do\n552:   if n ≤ 0 then\n553:     return 0\n554:   let mut total : Int := 0\n555:   let mut m : Int := n\n556:   for _ in List.range n.toNat do\n557:     if m > 0 then\n558:       total := total + m % 10\n559:       m := m / 10\n560:   return total\n561: \n562: abbrev mySumDigitsImp : Int → Int := sumDigitsImp\n563: abbrev progImp : Int → Int := sumDigitsImp\n564: \n565: /-- Checked imperative implementation returning `none` when `n < 0` and `some total` when `n ≥ 0`,\n566: directly mirroring the structure of Python's `prog`. -/\n567: def sumDigitsImp? (n : Int) : Option Int := Id.run do\n568:   if ¬ (n ≥ 0) then\n569:     return none\n570:   if n == 0 then\n571:     return some 0\n572:   let mut total : Int := 0\n573:   let mut m : Int := n\n574:   for _ in List.range n.toNat do\n575:     if m > 0 then\n576:       total := total + m % 10\n577:       m := m / 10\n578:   return some total\n579: \n580: /-! ## Imperative Tests -/\n581: \n582: example : sumDigitsImp 123 = 6 := by native_decide\n583: example : sumDigitsImp 0 = 0 := by native_decide\n584: example : sumDigitsImp 1 = 1 := by native_decide\n585: example : sumDigitsImp 7 = 7 := by native_decide\n586: example : sumDigitsImp 9 = 9 := by native_decide\n587: example : sumDigitsImp 10 = 1 := by native_decide\n588: example : sumDigitsImp 99 = 18 := by native_decide\n589: example : sumDigitsImp 999 = 27 := by native_decide\n590: example : sumDigitsImp 10005 = 6 := by native_decide\n591: example : sumDigitsImp (-1) = 0 := by native_decide\n592: \n593: example : sumDigitsImp? 123 = some 6 := by native_decide\n594: example : sumDigitsImp? 0 = some 0 := by native_decide\n595: example : sumDigitsImp? (-1) = none := by native_decide\n596: \n597: #eval sumDigitsImp 123\n598: #eval sumDigitsImp 0\n599: #eval sumDigitsImp 999\n600: #eval sumDigitsImp? 123\n601: #eval sumDigitsImp? (-1)\n602: \n603: /-! ## Equivalence Theorem: Functional = Imperative -/\n604: \n605: private theorem loop_invariant (xs : List Nat) (m total : Int) (hm : m.toNat ≤ xs.length) :\n606:     (Id.run (forIn xs (⟨m, total⟩ : MProd Int Int) (fun _ r => do\n607:       if r.fst > 0 then\n608:         return ForInStep.yield ⟨r.fst / 10, r.snd + r.fst % 10⟩\n609:       else\n610:         return ForInStep.yield ⟨r.fst, r.snd⟩))).snd = total + sumDigits m := by\n611:   induction xs generalizing m total with\n612:   | nil =>\n613:     simp only [List.length_nil, Nat.le_zero] at hm\n614:     have hm0 : m ≤ 0 := by omega\n615:     simp [sumDigits_le_zero hm0]\n616:   | cons _ tl ih =>\n617:     simp only [List.length_cons] at hm\n618:     by_cases hpos : m > 0\n619:     · simp only [List.forIn_cons, hpos, ↓reduceIte, pure_bind]\n620:       have hdiv : (m / 10).toNat ≤ tl.length := by omega\n621:       have ih_step := ih (m / 10) (total + m % 10) hdiv\n622:       simp only [Id.run] at ih_step ⊢\n623:       rw [ih_step, sumDigits_pos_step hpos]\n624:       omega\n625:     · simp only [List.forIn_cons, hpos, ↓reduceIte, pure_bind]\n626:       have hdiv : m.toNat ≤ tl.length := by omega\n627:       have ih_step := ih m total hdiv\n628:       simp only [Id.run] at ih_step ⊢\n629:       rw [ih_step]\n630: \n631: /-- Equivalence theorem between the functional implementation `sumDigits`\n632: and the imperative implementation `sumDigitsImp`. -/\n633: theorem equivalence_thm (n : Int) : sumDigits n = sumDigitsImp n := by\n634:   unfold sumDigitsImp\n635:   by_cases hn : n ≤ 0\n636:   · simp [hn, sumDigits_le_zero hn]\n637:   · simp only [hn, ↓reduceIte]\n638:     have hlen : n.toNat ≤ (List.range n.toNat).length := by simp\n639:     have hinv := loop_invariant (List.range n.toNat) n 0 hlen\n640:     simpa [Id.run] using hinv.symm\n641: \n642: /-- Equivalence theorem under the precondition `Pre n`. -/\n643: theorem equivalence_pre_thm (n : Int) (_h : Pre n) : sumDigits n = sumDigitsImp n :=\n644:   equivalence_thm n\n645: \n646: /-- Equivalence theorem for the checked implementations `sumDigits?` and `sumDigitsImp?`. -/\n647: theorem checked_equivalence_thm (n : Int) : sumDigits? n = sumDigitsImp? n := by\n648:   unfold sumDigits? sumDigitsImp?\n649:   by_cases hneg : n ≥ 0\n650:   · by_cases hz : n = 0\n651:     · subst hz\n652:       simp [sumDigits_zero]\n653:     · have hnotle : ¬ (n ≤ 0) := by omega\n654:       have hbeq : (n == 0) = false := beq_false_of_ne hz\n655:       simp only [hneg, not_true_eq_false, ↓reduceIte, hbeq, Bool.false_eq_true]\n656:       have hlen : n.toNat ≤ (List.range n.toNat).length := by simp\n657:       have hinv := loop_invariant (List.range n.toNat) n 0 hlen\n658:       simp only [Id.run, zero_add] at hinv\n659:       exact congrArg some hinv.symm\n660:   · simp [hneg]\n661: \n662: #eval Plausible.Testable.check (∀ n : Int, sumDigits n = sumDigitsImp n)\n663: example : (List.range 250).all (fun k => decide (sumDigits (k : Int) = sumDigitsImp (k : Int))) = true := by native_decide\n664: \n665: end «20_MySumDigits»"}
