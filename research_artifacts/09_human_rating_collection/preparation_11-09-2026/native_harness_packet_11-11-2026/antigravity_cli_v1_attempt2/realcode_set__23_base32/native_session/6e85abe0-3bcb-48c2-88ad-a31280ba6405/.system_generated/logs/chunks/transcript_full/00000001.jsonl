codeRaw rest).length - padCount (rest.length % 5) - 8 =\n        (b32encodeRaw rest).length - padCount (rest.length % 5) := by omega\n    rw [h2, List.append_assoc]\n\nlemma b32encode_eq_unpadded_append_pad (s : Bytes) :\n    b32encode s = b32encodeUnpadded s ++ List.replicate (padCount (s.length % 5)) 61 := by\n  induction s using b32encodeUnpadded.induct with\n  | case1 => rfl\n  | case2 b0 => rfl\n  | case3 b0 b1 => rfl\n  | case4 b0 b1 b2 => rfl\n  | case5 b0 b1 b2 b3 => rfl\n  | case6 b0 b1 b2 b3 b4 rest ih =>\n    have hmod : (b0 :: b1 :: b2 :: b3 :: b4 :: rest).length % 5 = rest.length % 5 := by\n      simp only [List.length_cons]; omega\n    rw [b32encode_cons5, ih, hmod]\n    simp [b32encodeUnpadded, List.append_assoc]\n\nlemma mem_encodeChunk5_ne_eq (b0 b1 b2 b3 b4 : UInt8) (x : UInt8) (hx : x ∈ encodeChunk5 b0 b1 b2 b3 b4) :\n    (x == 61) = false := by\n  dsimp only [encodeChunk5] at hx\n  simp only [List.mem_cons, List.not_mem_nil, or_false] at hx\n  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>\n    exact b32Char_ne_eq _ (Nat.mod_lt _ (by decide))\n\nlemma mem_b32encodeUnpadded_ne_eq (s : Bytes) (x : UInt8) (hx : x ∈ b32encodeUnpadded s) :\n    (x == 61) = false := by\n  induction s using b32encodeUnpadded.induct with\n  | case1 => simp [b32encodeUnpadded] at hx\n  | case2 b0 =>\n    exact mem_encodeChunk5_ne_eq b0 0 0 0 0 x (List.mem_of_mem_take hx)\n  | case3 b0 b1 =>\n    exact mem_encodeChunk5_ne_eq b0 b1 0 0 0 x (List.mem_of_mem_take hx)\n  | case4 b0 b1 b2 =>\n    exact mem_encodeChunk5_ne_eq b0 b1 b2 0 0 x (List.mem_of_mem_take hx)\n  | case5 b0 b1 b2 b3 =>\n    exact mem_encodeChunk5_ne_eq b0 b1 b2 b3 0 x (List.mem_of_mem_take hx)\n  | case6 b0 b1 b2 b3 b4 rest ih =>\n    simp only [b32encodeUnpadded, List.mem_append] at hx\n    rcases hx with hx1 | hx2\n    · exact mem_encodeChunk5_ne_eq b0 b1 b2 b3 b4 x hx1\n    · exact ih hx2\n\ndef rstripEq : Bytes → Bytes\n  | [] => []\n  | x :: xs =>\n    let r := rstripEq xs\n    if r.